        public async void AddDevice(string name, string ip)
        {
            this.IsEnabled = false;
            if (_scanCancelSource != null && !_scanCancelSource.IsCancellationRequested)
            {
                ShowMsg("다른 작업을 진행중입니다.");
                this.IsEnabled = true;
                return;
            }

            // 사용자가 IP가 아닌 시리얼/텍스트를 입력한 경우 추가하지 않음
            if (!IsValidIpEndpoint(ip))
            {
                ShowMsg("IP 형식이 올바르지 않습니다. 예) 192.168.0.10:5555");
                this.IsEnabled = true;
                return;
            }

            if (Devices.Any(d => d.Ip.Split(':')[0] == ip))
            {
                ShowMsg($"{ip} 기기는 이미 연결되어 있습니다.");
                this.IsEnabled = true;
                return;
            }

            int portStart = 30000, portEnd = 49999;
            int totalPort = portEnd - portStart + 1;
            var progress = new ProgressWindow(this);
            progress.Owner = this;
            progress.ShowInTaskbar = true;
            progress.Show();

            try
            {
                var openPorts = await ScanPortsAsync(
                    new List<string> { ip }, portStart, portEnd,
                    new Progress<int>((done) => progress.SetProgress(done, totalPort)));

                // HTTP Agent only - manual ADB connection removed
                bool connected = false;
                foreach (var (openIp, port) in openPorts)
                {
                    string addr = $"{openIp}:{port}";
                    // Check if Agent is available
                    var status = await AgentApi.GetStatusAsync(openIp, port);
                    if (status != null && !string.IsNullOrEmpty(status.Serial))
                    {
                        connected = true;
                        AddDevice(new Device { Serial = status.Serial, Ip = addr, Status = "Connected", AgentHost = openIp, AgentStatusPort = port });
                        ShowMsg($"{name} 기기가 성공적으로 연결되었습니다.\nIP: {addr}");
                        break;
                    }
                }

                if (!connected) ShowMsg($"{name} 기기 연결 실패: 열려있는 포트가 없거나 연결에 실패했습니다.");
            }
            catch (Exception ex)
            {
                ShowMsg("기기 추가 중 오류가 발생했습니다: " + ex.Message);
            }
            finally
            {
                progress.Close();
                this.IsEnabled = true;
            }
        }

        private void AddDevice(Device device)
        {
            if (device == null || string.IsNullOrEmpty(device.Ip)) { ShowMsg("유효하지 않은 기기 정보입니다."); return; }

            // 같은 시리얼이 이미 컬렉션에 있으면 추가하지 않음 (UnknownSerial 제외)
            if (!string.IsNullOrWhiteSpace(device.Serial) &&
                !string.Equals(device.Serial, "UnknownSerial", StringComparison.OrdinalIgnoreCase) &&
                Devices.Any(d => string.Equals(d.Serial, device.Serial, StringComparison.OrdinalIgnoreCase)))
                return;

            // IP 대상인 경우에만: USB(비-IP)로 이미 연결된 Quest면 중복 추가 방지
            if (Devices.Any(d => d.Ip == device.Ip)) { ShowMsg($"{device.Name} 기기는 이미 목록에 있습니다."); return; }
            if (device.Status != "Connected") { ShowMsg($"{device.Name} 기기가 연결되어 있지 않습니다."); return; }

            device.BatteryLevel = 0; // Will be updated by status polling
            device.Name = _serialNameDic.TryGetValue(device.Serial, out string name) ? name : device.Serial;

            Devices.Add(device);
            AddDeviceEvent?.Invoke(device);
        }

