        /// <summary>
        /// 공통 HTTP Agent 실행 helper - 후보 패키지 순차 시도
        /// </summary>
        private async Task<bool> LaunchCandidatesByAgentAsync(
            Device device,
            string[] candidates,
            object extras = null,
            bool forceRestart = false)
        {
            if (device == null)
                return false;

            if (string.IsNullOrWhiteSpace(device.AgentHost))
                return false;

            string activity = "com.unity3d.player.UnityPlayerActivity";

            foreach (var pkg in candidates)
            {
                bool launched = await AgentApi.LaunchAppAsync(
                    device.AgentHost,
                    device.AgentStatusPort > 0 ? device.AgentStatusPort : 18080,
                    pkg,
                    activity,
                    extras,
                    forceRestart);

                if (launched)
                    return true;
            }

            return false;
        }

        /// <summary>
        /// 공통 HTTP Agent 종료 helper - 모든 패키지 병렬 종료 시도
        /// </summary>
        private async Task<(bool anyStopOk, bool homeOk, List<string> failedPackages)> StopPackagesByAgentAsync(
            Device device,
            IEnumerable<string> packages,
            bool goHomeAfterStop = true)
        {
            var failedPackages = new List<string>();

            if (device == null)
                return (false, false, failedPackages);

            if (string.IsNullOrWhiteSpace(device.AgentHost))
                return (false, false, failedPackages);

            int port = device.AgentStatusPort > 0 ? device.AgentStatusPort : 18080;

            var distinctPackages = packages
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (distinctPackages.Count == 0)
                return (false, false, failedPackages);

            var tasks = distinctPackages.Select(async pkg =>
            {
                bool ok = await AgentApi.StopAppAsync(
                    device.AgentHost,
                    port,
                    pkg,
                    goHome: false);

                return (pkg, ok);
            });

            var results = await Task.WhenAll(tasks);

            foreach (var result in results)
            {
                if (!result.ok)
                    failedPackages.Add(result.pkg);
            }

            bool anyStopOk = results.Any(r => r.ok);

            bool homeOk = false;

            if (goHomeAfterStop)
            {
                homeOk = await AgentApi.GoHomeAsync(
                    device.AgentHost,
                    port);
            }

            return (anyStopOk, homeOk, failedPackages);
        }

