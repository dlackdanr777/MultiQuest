        /// <summary>
        /// Agent 디바이스 재연결 시도 예약
        /// Failed 상태의 Agent 디바이스를 주기적으로 재탐지하여 자동 재연결
        /// </summary>
        private void ScheduleAgentReconnect(Device device)
        {
            if (device == null || string.IsNullOrWhiteSpace(device.AgentHost)) return;

            lock (_agentReconnectAttempts)
            {
                var now = DateTime.UtcNow;

                // 이미 재연결 시도 중이면 스킵
                if (_agentReconnectAttempts.TryGetValue(device.Ip, out var lastAttempt))
                {
                    // 최소 10초 간격으로 재시도
                    if ((now - lastAttempt).TotalSeconds < 10)
                        return;
                }

                // 재연결 시도 시간 기록
                _agentReconnectAttempts[device.Ip] = now;
            }

            // 백그라운드에서 재연결 시도
            Task.Run(async () =>
            {
                try
                {
                    // ConnectionCheckTimer가 다시 체크하므로 여기서는 단순히 다음 체크 주기를 기다림
                    // 실제 상태는 ConnectionCheckTimer_Tick에서 업데이트됨
                    Debug.WriteLine($"[Agent Reconnect] Scheduled reconnection attempt for {device.Name} ({device.AgentHost}:{device.AgentStatusPort})");
                }
                catch (Exception ex)
                {
                    Debug.WriteLine($"[Agent Reconnect] Error scheduling reconnection for {device.Name}: {ex.Message}");
                }
            });
        }


        private async void ConnectionCheckTimer_Tick(object? sender, EventArgs e)
        {
            if (_isConnCheckRunning) return; // 중복 실행 방지
            _isConnCheckRunning = true;
            try
            {
                // Agent 디바이스와 ADB 디바이스 분리
                var agentDevices = Devices.Where(d => !string.IsNullOrWhiteSpace(d.AgentHost)).ToList();
                var adbDevices = Devices.Where(d => string.IsNullOrWhiteSpace(d.AgentHost)).ToList();

                // ===== HTTP Agent 디바이스 상태 체크 =====
                foreach (var device in agentDevices)
                {
                    try
                    {
                        var status = await AgentApi.GetStatusAsync(device.AgentHost, device.AgentStatusPort);

                        if (status != null)
                        {
                            // Agent 응답 성공: miss 카운트 리셋
                            lock (_missLock) { _missCounts[device.Ip] = 0; }

                            // 재연결 시도 기록 제거
                            lock (_agentReconnectAttempts)
                            {
                                _agentReconnectAttempts.Remove(device.Ip);
                            }

                            // 연결 상태로 표시
                            if (device.Status != "Connected")
                            {
                                device.Status = "Connected";
                                Debug.WriteLine($"[Agent Reconnect] Device {device.Name} ({device.AgentHost}:{device.AgentStatusPort}) reconnected successfully");
                            }
                        }
                        else
                        {
                            // Agent 응답 실패: miss 카운트 증가
                            int miss;
                            lock (_missLock)
                            {
                                if (!_missCounts.ContainsKey(device.Ip)) _missCounts[device.Ip] = 0;
                                _missCounts[device.Ip] = _missCounts[device.Ip] + 1;
                                miss = _missCounts[device.Ip];
                            }

                            if (miss >= MissThreshold)
                            {
                                if (device.Status != "Failed")
                                {
                                    device.Status = "Failed";
                                    Debug.WriteLine($"[Agent Disconnect] Device {device.Name} ({device.AgentHost}:{device.AgentStatusPort}) connection lost");
                                }

                                // Failed 상태에서도 주기적으로 재탐지 시도
                                ScheduleAgentReconnect(device);
                            }
                        }
                    }
                    catch
                    {
                        // Agent 통신 예외 처리
                        int miss;
                        lock (_missLock)
                        {
                            if (!_missCounts.ContainsKey(device.Ip)) _missCounts[device.Ip] = 0;
                            _missCounts[device.Ip] = _missCounts[device.Ip] + 1;
                            miss = _missCounts[device.Ip];
                        }

                        if (miss >= MissThreshold)
                        {
                            if (device.Status != "Failed")
                            {
                                device.Status = "Failed";
                                Debug.WriteLine($"[Agent Disconnect] Device {device.Name} ({device.AgentHost}:{device.AgentStatusPort}) connection lost (exception)");
                            }

                            // Failed 상태에서도 주기적으로 재탐지 시도
                            ScheduleAgentReconnect(device);
                        }
                    }
                }

                // ADB status check removed - using HTTP Agent only
            }
            finally
            {
                _isConnCheckRunning = false;
            }
        }

        /// <summary>Connected인데 scrcpy 프로세스가 없는 기기를 감지해 재시작을 예약한다.</summary>
        private void ScheduleReconnect(Device device)
        {
            if (device == null || string.IsNullOrWhiteSpace(device.Ip)) return;

            ReconnectState st;
            lock (_reconnectStates)
            {
                if (!_reconnectStates.TryGetValue(device.Ip, out st))
                {
                    st = new ReconnectState { Attempt = 0, NextUtc = DateTime.MinValue, IsRunning = false };
                    _reconnectStates[device.Ip] = st;
                }

                // 아직 대기 시간
                if (st.IsRunning || DateTime.UtcNow < st.NextUtc) return;
                st.IsRunning = true;
            }

            _ = Task.Run(async () =>
            {
                bool ok = false;
                // ADB 재연결 로직 제거됨 - Agent가 있는 기기만 자동 재연결
                try
                {
                    // Agent가 있으면 Agent 상태 체크로 자동 복구됨
                    ok = !string.IsNullOrWhiteSpace(device.AgentHost);
                }
                catch { }
                finally
                {
                    lock (_reconnectStates)
                    {
                        if (_reconnectStates.TryGetValue(device.Ip, out var s))
                        {
                            if (ok)
                            {
                                s.Attempt = 0;
                                s.NextUtc = DateTime.UtcNow.AddSeconds(2);
                            }
                            else
                            {
                                s.Attempt = Math.Min(s.Attempt + 1, 10);
                                // 지수 백오프 (최대 60초)
                                var delaySec = Math.Min(60, (int)Math.Pow(2, s.Attempt));
                                s.NextUtc = DateTime.UtcNow.AddSeconds(delaySec);
                            }
                            s.IsRunning = false;
                        }
                    }
                }
            });
        }

        /// <summary>
        /// 통합 상태 체크: 배터리, RTSP, 오프라인 감지를 짧은 주기로 처리
        /// </summary>
        private async void UpdateStatus(object? sender, EventArgs e)
        {
            if (_isStatusCheckRunning) return;
            _isStatusCheckRunning = true;
            try
            {
                // Agent가 있는 기기는 Agent API로, 없으면 ADB로 상태 조회
                var targets = Devices.Where(d => d != null && 
                    (d.Status == "Connected" || !string.IsNullOrWhiteSpace(d.AgentHost))).ToList();

                if (targets.Count == 0) return;

                // 모든 디바이스 상태를 병렬로 동시 조회
                var tasks = targets.Select(device => Task.Run(async () =>
                {
                    int level = -1;
                    bool isCharging = false;
                    string chargingStatus = null;
                    string serial = null;
                    string newRtspUrl = null;
                    string streamState = null;
                    string deviceName = null;
                    bool statusSuccess = false;

                    // 1순위: Agent API 사용
                    if (!string.IsNullOrWhiteSpace(device.AgentHost))
                    {
                        try
                        {
                            var status = await AgentApi.GetStatusAsync(device.AgentHost, device.AgentStatusPort);
                            if (status != null)
                            {
                                statusSuccess = true;
                                if (status.Battery >= 0)
                                    level = status.Battery;
                                isCharging = status.IsCharging;
                                chargingStatus = status.ChargingStatus;
                                serial = status.Serial;
                                newRtspUrl = status.RtspUrl;
                                streamState = status.StreamState;
                                deviceName = status.DeviceName;
                            }
                        }
                        catch { }
                    }

                    // ADB battery fallback removed - using HTTP Agent only

                    return (device.Ip, level, isCharging, chargingStatus, serial, newRtspUrl, streamState, deviceName, statusSuccess);
                }));

                var results = await Task.WhenAll(tasks);

                // UI 업데이트는 한 번의 Dispatcher.Invoke 로 일괄 처리
                Dispatcher.Invoke(() =>
                {
                    foreach (var (ip, level, isCharging, chargingStatus, serial, rtspUrl, streamState, deviceName, statusSuccess) in results)
                    {
                        var d = Devices.FirstOrDefault(d => d.Ip == ip);
                        if (d != null)
                        {
                            // 빠른 오프라인 감지: Agent 디바이스의 상태 체크 실패 시 miss 카운트 증가
                            if (!string.IsNullOrWhiteSpace(d.AgentHost))
                            {
                                if (!statusSuccess)
                                {
                                    int miss;
                                    lock (_missLock)
                                    {
                                        if (!_missCounts.ContainsKey(d.Ip)) _missCounts[d.Ip] = 0;
                                        _missCounts[d.Ip] = _missCounts[d.Ip] + 1;
                                        miss = _missCounts[d.Ip];
                                    }

                                    // 2회 연속 실패 시 빠르게 Failed 상태로 전환 (3초 × 2 = 6초)
                                    if (miss >= 2)
                                    {
                                        if (d.Status != "Failed")
                                        {
                                            d.Status = "Failed";
                                            Debug.WriteLine($"[Fast Offline] Device {d.Name} ({d.AgentHost}:{d.AgentStatusPort}) detected offline");
                                        }
                                    }
                                }
                                else
                                {
                                    // 성공 시 miss 카운트 리셋
                                    lock (_missLock) { _missCounts[d.Ip] = 0; }

                                    // Failed 상태였으면 Connected로 복구
                                    if (d.Status == "Failed")
                                    {
                                        d.Status = "Connected";
                                        Debug.WriteLine($"[Fast Recovery] Device {d.Name} ({d.AgentHost}:{d.AgentStatusPort}) back online");
                                    }
                                }
                            }

                            if (level >= 0) d.BatteryLevel = level;
                            d.IsCharging = isCharging;
                            if (!string.IsNullOrEmpty(chargingStatus)) d.ChargingStatus = chargingStatus;
                            if (!string.IsNullOrEmpty(serial) && string.IsNullOrEmpty(d.Serial)) d.Serial = serial;

                            // StreamState 업데이트
                            if (!string.IsNullOrWhiteSpace(streamState))
                            {
                                d.StreamState = streamState;
                            }

                            // 이름 설정 우선순위 (빈 문자열과 공백 체크 강화)
                            // 1. Agent가 보낸 고유 식별 이름 (비어있지 않고 공백이 아닐 때)
                            if (!string.IsNullOrWhiteSpace(deviceName))
                            {
                                d.Name = deviceName.Trim();
                                Debug.WriteLine($"[UpdateBattery] Device {d.Ip} name from Agent: '{d.Name}'");
                            }
                            // 2. Settings의 Serial 매핑 사용
                            else if (!string.IsNullOrEmpty(d.Serial) && _serialNameDic.TryGetValue(d.Serial, out var mappedName) && !string.IsNullOrWhiteSpace(mappedName))
                            {
                                d.Name = mappedName.Trim();
                                Debug.WriteLine($"[UpdateBattery] Device {d.Ip} name from Settings: '{d.Name}'");
                            }
                            // 3. Model 정보 사용 (Quest 3, Quest 3S 등)
                            else if (d.Name == null || d.Name == d.Serial || d.Name == d.Ip || string.IsNullOrWhiteSpace(d.Name))
                            {
                                // Agent 상태에서 Model 정보 가져오기 시도
                                if (!string.IsNullOrWhiteSpace(d.AgentHost))
                                {
                                    // Model은 Agent 검색 시 이미 설정되어 있어야 함
                                    // 여기서는 기존 Model이 있으면 유지
                                    if (string.IsNullOrWhiteSpace(d.Name))
                                    {
                                        d.Name = d.Serial ?? d.Ip ?? "Unknown";
                                    }
                                }
                            }

                            // RTSP URL 처리
                            if (!string.IsNullOrEmpty(rtspUrl))
                            {
                                bool urlChanged = d.RtspUrl != rtspUrl;

                                d.RtspUrl = rtspUrl;

                                // URL이 변경되었으면 하드 재시작
                                if (urlChanged && d.Rtsp != null)
                                {
                                    HardRestartRtspTile(d, "RTSP URL changed");
                                }
                            }
                        }

                        // RTSP 포트 복구 체크 (비동기로 백그라운드 실행)
                        _ = CheckRtspRecoveryAsync(ip, rtspUrl, streamState);
                    }
                });
            }
            finally
            {
                _isStatusCheckRunning = false;
            }
        }

        private void OnChangeSerialName(IReadOnlyDictionary<string, string> serialNameDic)
        {
            // 최신 스냅샷으로 갱신 (저장 직후 반영 누락 방지)
            _serialNameDic = serialNameDic ?? new Dictionary<string, string>();

            foreach (var device in Devices)
            {
                if (_serialNameDic.TryGetValue(device.Serial, out var name))
                {
                    if (device.Name?.Equals(name, StringComparison.Ordinal) == true) continue;
                    device.Name = name;
                }
                else
                {
                    device.Name = device.Serial; // 시리얼을 이름으로 사용
                }
            }
            // 이름 변경 즉시 UI 반영
            UpdateDeviceLabels();
        }

        // 디바이스 이름(Label) 즉시 반영
        private void UpdateDeviceLabels()
        {
            if (Tiles == null || Devices == null) return;
            foreach (var device in Devices)
            {
                var host = FindInItemTemplate<Border>(Tiles, device, "PART_MirrorHost");
                if (host == null) continue;
                var label = FindVisualChildByName<System.Windows.Controls.Label>(host, "DeviceNameLabel");
                if (label != null) label.Content = device.Name;
            }
        }

