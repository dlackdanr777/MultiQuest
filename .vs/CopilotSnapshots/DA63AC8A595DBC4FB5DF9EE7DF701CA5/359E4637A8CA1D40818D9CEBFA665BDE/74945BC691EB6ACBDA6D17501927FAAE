        /// <summary>
        /// 모든 StoryWing 앱 종료 요청.
        /// 신규 엔드포인트(/command/stopAllStoryWing) 시도 후 404이면
        /// fallbackPackages 목록으로 개별 StopAppAsync 폴백 실행.
        /// </summary>
        public static async Task<bool> StopAllStoryWingAsync(
            string host,
            int port = 18080,
            bool goHome = true,
            IEnumerable<string> fallbackPackages = null,
            CancellationToken ct = default)
        {
            if (string.IsNullOrWhiteSpace(host))
                return false;

            if (port <= 0)
                port = 18080;

            // ── 1단계: 신규 엔드포인트 시도 ──────────────────────────────
            bool shouldFallback = false;

            try
            {
                string url = $"http://{host}:{port}/command/stopAllStoryWing";

                var body = new
                {
                    goHome,
                    retryCount      = 3,
                    retryIntervalMs = 150,
                    goHomeDelayMs   = 600
                };

                using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(ct);
                timeoutCts.CancelAfter(TimeSpan.FromSeconds(15));

                using var request = new HttpRequestMessage(HttpMethod.Post, url)
                {
                    Content = JsonContent.Create(body, options: _jsonOptions)
                };

                using var response = await _http.SendAsync(
                    request,
                    HttpCompletionOption.ResponseHeadersRead,
                    timeoutCts.Token
                ).ConfigureAwait(false);

                string responseText = await response.Content
                    .ReadAsStringAsync(timeoutCts.Token)
                    .ConfigureAwait(false);

                System.Diagnostics.Debug.WriteLine(
                    $"[AgentApi] StopAllStoryWing -> HTTP {(int)response.StatusCode}: {responseText}");

                if (response.IsSuccessStatusCode)
                    return true;

                // 404/405/501만 폴백 대상
                if (response.StatusCode is 
                    System.Net.HttpStatusCode.NotFound or
                    System.Net.HttpStatusCode.MethodNotAllowed or
                    System.Net.HttpStatusCode.NotImplemented)
                {
                    shouldFallback = true;
                    System.Diagnostics.Debug.WriteLine(
                        $"[AgentApi] StopAllStoryWing: {response.StatusCode} → fallback to per-package stop");
                }
                else
                {
                    // 다른 HTTP 오류는 즉시 실패
                    return false;
                }
            }
            catch (OperationCanceledException) when (ct.IsCancellationRequested)
            {
                System.Diagnostics.Debug.WriteLine(
                    "[AgentApi] StopAllStoryWing cancelled by caller");
                return false;
            }
            catch (OperationCanceledException)
            {
                System.Diagnostics.Debug.WriteLine(
                    "[AgentApi] StopAllStoryWing timeout");
                return false;
            }
            catch (HttpRequestException ex)
            {
                System.Diagnostics.Debug.WriteLine(
                    $"[AgentApi] StopAllStoryWing network error: {ex.Message}");
                return false;
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine(
                    $"[AgentApi] StopAllStoryWing unexpected error: {ex.GetType().Name}: {ex.Message}");
                return false;
            }

            // ── 2단계: 폴백 - 패키지별 개별 종료 ─────────────────────────
            if (!shouldFallback)
                return false;

            var pkgs = fallbackPackages?
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList()
                ?? new List<string>();

            if (pkgs.Count == 0)
            {
                // 폴백이 필요하지만 종료할 패키지가 없으면 실패
                System.Diagnostics.Debug.WriteLine(
                    "[AgentApi] StopAllStoryWing fallback: no packages to stop");
                return false;
            }

            bool[] stopResults = await Task.WhenAll(
                pkgs.Select(pkg => StopAppAsync(host, port, pkg, goHome: false, ct))
            ).ConfigureAwait(false);

            bool stopSucceeded = stopResults.All(x => x);

            bool homeSucceeded = !goHome ||
                await GoHomeAsync(host, port, ct).ConfigureAwait(false);

            bool finalResult = stopSucceeded && homeSucceeded;

            System.Diagnostics.Debug.WriteLine(
                $"[AgentApi] StopAllStoryWing fallback result: stop={stopSucceeded}, home={homeSucceeded}, final={finalResult}");

            return finalResult;
        }

        /// <summary>
        /// 전체 기기 동시 종료용 빠른 경로.
        /// fallbackPackages를 돌리지 않고 stopAllStoryWing만 빠르게 호출합니다.
        /// Agent는 즉시 200 OK를 반환하고 실제 종료는 내부 백그라운드에서 처리합니다.
        /// </summary>
        public static async Task<bool> StopAllStoryWingFastAsync(
            string host,
            int port = 18080,
            bool goHome = true,
            int retryCount = 2,
            int retryIntervalMs = 100,
            int goHomeDelayMs = 250,
            CancellationToken ct = default)
        {
            if (string.IsNullOrWhiteSpace(host))
                return false;

            if (port <= 0)
                port = 18080;

            try
            {
                string url = $"http://{host}:{port}/command/stopAllStoryWing";

                var body = new
                {
                    goHome,
                    retryCount,
                    retryIntervalMs,
                    goHomeDelayMs,
                    fast = true
                };

                using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(ct);
                timeoutCts.CancelAfter(TimeSpan.FromSeconds(3));

                using var request = new HttpRequestMessage(HttpMethod.Post, url)
                {
                    Content = JsonContent.Create(body, options: _jsonOptions)
                };

                using var response = await _http.SendAsync(
                    request,
                    HttpCompletionOption.ResponseHeadersRead,
                    timeoutCts.Token
                ).ConfigureAwait(false);

                System.Diagnostics.Debug.WriteLine(
                    $"[AgentApi] StopAllStoryWingFast {host}:{port} -> {(int)response.StatusCode}");

                return response.IsSuccessStatusCode;
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine(
                    $"[AgentApi] StopAllStoryWingFastAsync failed: {host}:{port} {ex.Message}");
                return false;
            }
        }

