        // ========== 안정화된 FindInItemTemplate ==========

        public T FindInItemTemplate<T>(ItemsControl itemsControl, object item, string elementName)
            where T : FrameworkElement
        {
            var container = itemsControl.ItemContainerGenerator.ContainerFromItem(item) as FrameworkElement;
            if (container == null)
            {
                // UpdateLayout은 전체 레이아웃 트리를 강제 재계산하므로 꼭 필요할 때만 호출
                if (itemsControl.ItemContainerGenerator.Status == System.Windows.Controls.Primitives.GeneratorStatus.ContainersGenerated)
                    itemsControl.UpdateLayout();
                container = itemsControl.ItemContainerGenerator.ContainerFromItem(item) as FrameworkElement;
                if (container == null) return null;
            }

            container.ApplyTemplate();

            if (container is ContentPresenter cp)
            {
                var tpl = cp.ContentTemplate ?? itemsControl.ItemTemplate;
                if (tpl != null)
                {
                    try
                    {
                        var el = tpl.FindName(elementName, cp) as T;
                        if (el != null) return el;
                    }
                    catch (InvalidOperationException)
                    {
                        // 템플릿 미적용 예외 → fallback
                    }
                }
            }

            return FindVisualChildByName<T>(container, elementName);
        }

        private static T FindVisualChildByName<T>(DependencyObject parent, string name)
            where T : FrameworkElement
        {
            int count = VisualTreeHelper.GetChildrenCount(parent);
            for (int i = 0; i < count; i++)
            {
                var child = VisualTreeHelper.GetChild(parent, i);
                if (child is T fe && fe.Name == name)
                    return fe;

                var result = FindVisualChildByName<T>(child, name);
                if (result != null) return result;
            }
            return null;
        }

        // =============== 타일 내부 수동 버튼 ===============
        private async void RefreshTile_Click(object sender, RoutedEventArgs e)
        {
            if (_isRefreshing)
            {
                MessageBox.Show("이미 새로고침 중입니다.");
                return;
            }
            _isRefreshing = true;
            if ((sender as Button)?.CommandParameter is not Device device) { _isRefreshing = false; return; }

            // 이미 HardRestart 진행 중이면 무시
            string host = !string.IsNullOrWhiteSpace(device.AgentHost)
                ? device.AgentHost : GetHostOnly(device.Ip);
            lock (_rtspHealthLock)
            {
                if (_rtspRestartInProgress.Contains(host))
                {
                    _isRefreshing = false;
                    return;
                }
            }

            // Agent 캡처 재시작 + RTSP 타일 재연결
            if (!string.IsNullOrWhiteSpace(device.AgentHost))
            {
                try
                {
                    int port = device.AgentStatusPort > 0 ? device.AgentStatusPort : 18080;

                    // 1. 화면 깨우기 + 컡포 재시작 병렬 실행
                    Debug.WriteLine($"[Refresh] {device.Name} Wake + restartCapture 병렬 요청");
                    var wakeTask = AgentApi.WakeScreenAsync(device.AgentHost, port, keepAwake: true);
                    var restartTask = AgentApi.RestartCaptureAsync(device.AgentHost, port);
                    await Task.WhenAll(wakeTask, restartTask);
                    Debug.WriteLine($"[Refresh] {device.Name} restartCapture={restartTask.Result}");

                    // 2. RTSP 서버가 올라올 때까지 폴링 (최대 3초, 500ms 간격)
                    QuestAgentInfo status = null;
                    for (int i = 0; i < 6; i++)
                    {
                        await Task.Delay(500);
                        status = await AgentApi.GetStatusFastAsync(device.AgentHost, port);
                        if (status != null &&
                            (string.Equals(status.StreamState, "RUNNING", StringComparison.OrdinalIgnoreCase) ||
                             string.Equals(status.StreamState, "STARTING", StringComparison.OrdinalIgnoreCase)))
                            break;
                    }

                    // 3. 상태 갱신
                    if (status != null)
                    {
                        if (!string.IsNullOrEmpty(status.RtspUrl))
                            device.RtspUrl = status.RtspUrl;
                        if (!string.IsNullOrWhiteSpace(status.StreamState))
                            device.StreamState = status.StreamState;
                    }

                    // 4. WPF RTSP 타일 재연결
                    if (device.Rtsp != null)
                        await HardRestartRtspTileAsync(device, "manual refresh: after restartCapture");
                }
                finally
                {
                    _isRefreshing = false;
                }
            }
            else
            {
                _isRefreshing = false;
            }
        }

