        // ====================== 프로파일 자동 감지 ======================

        /// <summary>
        /// 15초마다 네트워크/CPU 상태를 측정하여 프로파일을 자동 결정합니다.
        /// 수동 모드(_profileAutoMode == false)일 때는 동작하지 않습니다.
        /// </summary>
        private void ProfileAutoTimer_Tick(object? sender, EventArgs e)
        {
            if (!_profileAutoMode) return;

            try
            {
                // 1) CPU 측정 — 항상 EMA 적용 (초기 스파이크 무시)
                double cpu = 0;
                try { cpu = _cpuCounter?.NextValue() ?? 0; } catch { }
                _cpuUsage = _cpuUsage < 0.01
                    ? cpu                             // 첫 샘플
                    : _cpuUsage * 0.5 + cpu * 0.5;   // EMA α=0.5 (빠른 반응 → CPU 급등 즉시 감지)

                // 2) 버퍼링률 — 연결 안정화 60초 이상 된 스트림만 사용
                //    BufferingRate 단위 = 이벤트/초 (count / elapsed_seconds)
                double totalRate = 0;
                int count = 0;
                foreach (var device in Devices)
                {
                    if (device.Rtsp == null) continue;
                    var info = _rtspQualityManager.GetStreamInfo(device.AgentHost);
                    // 연결 초기 60초는 VLC 버퍼링 이벤트가 많이 발생 → 제외
                    if (info == null || info.Uptime < 60) continue;
                    totalRate += info.BufferingRate;
                    count++;
                }

                double avgBuf = count > 0 ? totalRate / count : 0;
                _avgBufferingRate = _avgBufferingRate < 0.000001
                    ? avgBuf
                    : _avgBufferingRate * 0.7 + avgBuf * 0.3;

                int totalStreams = Devices.Count(d => d.Rtsp != null);

                // 3) 프로파일 결정
                var decided = DecideProfile(_cpuUsage, _avgBufferingRate, totalStreams);

                // hint: bufRate를 "이벤트/분"으로 표시하면 직관적
                string hint = $"CPU {_cpuUsage:F0}%  버퍼 {_avgBufferingRate * 60:F1}/분  {totalStreams}대";
                Debug.WriteLine(
                    $"[ProfileAuto] cpu={_cpuUsage:F0}% bufRate={_avgBufferingRate:F4}/s " +
                    $"stableStreams={count}/{totalStreams} → {decided}");

                if (decided != _operationProfile)
                    ApplyProfile(decided);

                if (TxtProfileHint != null)
                    TxtProfileHint.Text = hint;
            }
            catch (Exception ex)
            {
                Debug.WriteLine($"[ProfileAuto] 오류: {ex.Message}");
            }
        }

        /// <summary>
        /// CPU 점유율과 평균 버퍼링률(이벤트/초)을 기반으로 최적 프로파일을 결정합니다.
        ///
        /// BufferingRate 단위: 이벤트/초 (VLC Buffering 이벤트 수 / 경과 초)
        ///   VLC는 버퍼링 1회에 0%·25%·50%·75%·100% 이벤트를 여러 번 발생시킴.
        ///   실제 "끊김 없음" 상태 = 0.0~0.02/s 수준.
        ///   실제 "심각한 끊김" 상태 = 0.5/s 이상.
        /// </summary>
        private static RtspOperationProfile DecideProfile(
            double cpuPct, double bufRatePerSec, int streamCount)
        {
            // ─ 안정 우선 조건 ─────────────────────────────────────────
            // CPU 65% 이상 (n150 4코어 저전력 CPU 기준 — 이 수치를 넘으면 체감 지연 발생)
            if (cpuPct >= 65)
                return RtspOperationProfile.Stability;

            // 버퍼링 0.3/s 이상 = 스트림당 분당 18회 = 심각한 네트워크 문제
            if (bufRatePerSec >= 0.3)
                return RtspOperationProfile.Stability;

            // 16대 이상 + CPU 55% 이상
            if (streamCount >= 16 && cpuPct >= 55)
                return RtspOperationProfile.Stability;

            // ─ 화질 우선 조건 ─────────────────────────────────────────
            // CPU 35% 이하 + 버퍼링 거의 없음(분당 1회 미만) + 8대 이하 (n150 4코어 기준 보수적 임계값)
            if (cpuPct <= 35 && bufRatePerSec <= 0.015 && streamCount <= 8)
                return RtspOperationProfile.Quality;

            // ─ 기본 균형 ──────────────────────────────────────────────
            return RtspOperationProfile.Balanced;
        }

        /// <summary>
        /// 프로파일을 적용하고 UI와 로그를 갱신합니다.
        /// 실행 중인 타일은 다음 HardRestart 때 새 프로파일이 적용됩니다.
        /// </summary>
        private void ApplyProfile(RtspOperationProfile profile)
        {
            _operationProfile = profile;
            UpdateProfileUI();
            Debug.WriteLine($"[Profile] 전환 → {profile}");
        }

        /// <summary>
        /// 사이드바 프로파일 패널 UI를 현재 상태에 맞게 갱신합니다.
        /// </summary>
        private void UpdateProfileUI()
        {
            if (TxtProfileName == null) return;

            // 프로파일 이름 + 색상
            (string label, string color) = _operationProfile switch
            {
                RtspOperationProfile.Stability => ("안정 우선", "#FF8C42"),
                RtspOperationProfile.Quality => ("화질 우선", "#3CE48C"),
                _ => ("균형", "#5B9BD5")
            };
            TxtProfileName.Text = label;
            TxtProfileName.Foreground = new System.Windows.Media.SolidColorBrush(
                (System.Windows.Media.Color)System.Windows.Media.ColorConverter.ConvertFromString(color));

            // AUTO 배지
            TxtAutoMode.Text = _profileAutoMode ? "AUTO" : "수동";
            TxtAutoMode.Foreground = _profileAutoMode
                ? new System.Windows.Media.SolidColorBrush(
                    System.Windows.Media.Colors.LightGreen)
                : new System.Windows.Media.SolidColorBrush(
                    System.Windows.Media.Colors.Orange);

            // 수동 모드일 때 "자동 감지 켜기" 버튼 표시
            BtnProfileAuto.Visibility = _profileAutoMode
                ? Visibility.Collapsed
                : Visibility.Visible;

            // 활성 버튼 강조
            HighlightProfileButton(_operationProfile);
        }

        private void HighlightProfileButton(RtspOperationProfile active)
        {
            var activeColor = System.Windows.Media.Color.FromRgb(0x1E, 0x4A, 0x8A);
            var normalColor = System.Windows.Media.Color.FromRgb(0x2A, 0x34, 0x44);

            BtnProfileStability.Background = new System.Windows.Media.SolidColorBrush(
                active == RtspOperationProfile.Stability ? activeColor : normalColor);
            BtnProfileBalanced.Background = new System.Windows.Media.SolidColorBrush(
                active == RtspOperationProfile.Balanced ? activeColor : normalColor);
            BtnProfileQuality.Background = new System.Windows.Media.SolidColorBrush(
                active == RtspOperationProfile.Quality ? activeColor : normalColor);

            var activeText = System.Windows.Media.Colors.White;
            var normalText = System.Windows.Media.Color.FromRgb(0x9D, 0xB0, 0xC9);

            BtnProfileStability.Foreground = new System.Windows.Media.SolidColorBrush(
                active == RtspOperationProfile.Stability ? activeText : normalText);
            BtnProfileBalanced.Foreground = new System.Windows.Media.SolidColorBrush(
                active == RtspOperationProfile.Balanced ? activeText : normalText);
            BtnProfileQuality.Foreground = new System.Windows.Media.SolidColorBrush(
                active == RtspOperationProfile.Quality ? activeText : normalText);
        }

