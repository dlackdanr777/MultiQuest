        /// <summary>
        /// 통합 상태 체크: 배터리, RTSP, 오프라인 감지를 짧은 주기로 처리
        /// </summary>
        private async void UpdateStatus(object? sender, EventArgs e)
        {
            // 전체 앱 실행 중에는 16대 상태 폴링 버스트를 잠시 중지합니다.
            // 4GB 메모리/저전력 CPU 환경에서 명령 HTTP가 상태 조회와 경쟁하지 않게 합니다.
            if (_isFleetLaunchRunning) return;
            if (_isStatusCheckRunning) return;
            _isStatusCheckRunning = true;
            try
            {
                var targets = Devices
                    .Where(d => d != null && !string.IsNullOrWhiteSpace(d.AgentHost))
                    .ToList();

                if (targets.Count == 0) return;

                // 1초 타임아웃으로 병렬 조회
                var tasks = targets.Select(device => Task.Run(async () =>
                {
                    var status = await AgentApi.GetStatusFastAsync(
                        device.AgentHost, device.AgentStatusPort);
                    return (Ip: device.Ip, Status: status);
                }));

                var results = await Task.WhenAll(tasks);

                await Dispatcher.InvokeAsync(() =>
                {
                    foreach (var item in results)
                    {
                        string ip = item.Ip;
                        QuestAgentInfo status = item.Status;

                        // DeviceId 우선, 없으면 IP 폴백
                        Device d;
                        if (status != null && !string.IsNullOrWhiteSpace(status.DeviceId))
                            d = Devices.FirstOrDefault(x =>
                                string.Equals(x.AgentDeviceId, status.DeviceId, StringComparison.OrdinalIgnoreCase))
                              ?? Devices.FirstOrDefault(x => x.Ip == ip);
                        else
                            d = Devices.FirstOrDefault(x => x.Ip == ip);

                        if (d == null) continue;

                        // DeviceId 갱신
                        if (status != null && !string.IsNullOrWhiteSpace(status.DeviceId))
                            d.AgentDeviceId = status.DeviceId;

                        if (status == null)
                        {
                            // 응답 없음 → 단계적 상태 전환
                            // 3초 × 3회 = 9초 → 노란불, × 6회 = 18초 → 주황불, × 10회 = 30초 → 빨간불
                            int miss;
                            lock (_missLock)
                            {
                                _missCounts.TryGetValue(d.Ip, out miss);
                                _missCounts[d.Ip] = ++miss;
                            }

                            if (miss >= 10 && d.Status != "Failed")
                            {
                                d.Status = "Failed";
                                d.StreamState = null;
                                try { d.Rtsp?.Stop(); } catch { }
                                Debug.WriteLine($"[Offline] {d.Name} 오프라인 (miss={miss})");
                            }
                            else if (miss >= 6 && miss < 10 && d.Status != "Checking" && d.Status != "Failed")
                            {
                                d.Status = "Checking";
                                Debug.WriteLine($"[Checking] {d.Name} 재확인 중 (miss={miss})");
                            }
                            else if (miss >= 3 && miss < 6 && d.Status != "Unstable" && d.Status != "Checking" && d.Status != "Failed")
                            {
                                d.Status = "Unstable";
                                Debug.WriteLine($"[Unstable] {d.Name} 응답 지연 (miss={miss})");
                            }
                        }
                        else
                        {
                            // 응답 성공
                            lock (_missLock) { _missCounts[d.Ip] = 0; }

                            if (d.Status == "Failed" || d.Status == "Checking" || d.Status == "Unstable" || d.Status == "AgentOnly")
                            {
                                d.Status = "Connected";
                                Debug.WriteLine($"[Online] {d.Name} ({d.AgentHost}) 재연결");
                                // RTSP URL이 있으면 타일 재시작
                                if (!string.IsNullOrWhiteSpace(d.RtspUrl))
                                    HardRestartRtspTile(d, "reconnected");
                            }

                            if (status.Battery >= 0) d.BatteryLevel = status.Battery;
                            d.IsCharging = status.IsCharging;
                            if (!string.IsNullOrEmpty(status.ChargingStatus))
                                d.ChargingStatus = status.ChargingStatus;
                            if (!string.IsNullOrEmpty(status.Serial) && string.IsNullOrEmpty(d.Serial))
                                d.Serial = status.Serial;

                            if (!string.IsNullOrWhiteSpace(status.StreamState))
                            {
                                bool httpStopped =
                                    string.Equals(status.StreamState, "STOPPED", StringComparison.OrdinalIgnoreCase) ||
                                    string.Equals(status.StreamState, "IDLE", StringComparison.OrdinalIgnoreCase);
                                bool agentFrozenOrError =
                                    string.Equals(status.StreamState, "FROZEN", StringComparison.OrdinalIgnoreCase) ||
                                    string.Equals(status.StreamState, "ERROR", StringComparison.OrdinalIgnoreCase);
                                bool rtspFrozen = d.Rtsp?.IsFrozen == true;
                                bool httpSaysRunning =
                                    string.Equals(status.StreamState, "RUNNING", StringComparison.OrdinalIgnoreCase);
                                bool httpIsStarting =
                                    string.Equals(status.StreamState, "STARTING", StringComparison.OrdinalIgnoreCase);
                                bool httpSaysActive = httpSaysRunning;

                                if (httpIsStarting)
                                {
                                    d.StreamState = status.StreamState;
                                    d.AgentStoppedSinceUtc = DateTime.MinValue;

                                    // STARTING 중에는 RTSP 타일을 붙이지 않습니다.
                                    // 서버/MediaProjection/Encoder가 아직 준비 중일 수 있습니다.
                                    d.MirrorError = "화면공유 준비 중";

                                    Debug.WriteLine($"[StreamStarting] {d.Name} Agent STARTING → RTSP 재생 대기");
                                }
                                else if (httpStopped)
                                {
                                    d.StreamState = status.StreamState;
                                    d.MirrorError = "화면공유 중지됨 - Android Agent 복구 대기";

                                    if (d.Rtsp != null && d.Rtsp.IsPlaying)
                                    {
                                        Debug.WriteLine($"[StreamStop] {d.Name} Agent {status.StreamState} → RTSP 타일 정지");
                                        try { d.Rtsp.Stop(); } catch { }
                                    }

                                    d.AgentStoppedSinceUtc = DateTime.UtcNow;

                                    // 중요:
                                    // 여기서 WPF가 startCaptureUi를 자동 호출하지 않습니다.
                                    // 화면공유 재시작은 Android AgentService 와치독이 담당합니다.
                                }
                                else if (agentFrozenOrError)
                                {
                                    // Android 와치독이 복구를 담당합니다.
                                    // WPF는 restartCapture를 보내지 않고 _rtspWasDown에 등록만.
                                    // Agent가 RUNNING으로 복구되면 CheckRtspRecoveryAsync가 HardRestart합니다.
                                    d.StreamState = status.StreamState;
                                    d.AgentStoppedSinceUtc = DateTime.MinValue; // 복구 시 리셋
                                    Debug.WriteLine(
                                        $"[AgentFrozen] {d.Name} Agent state={status.StreamState}. " +
                                        $"Android 와치독이 복구합니다. WPF restartCapture 안 보냄");
                                    if (!string.IsNullOrWhiteSpace(d.RtspUrl) &&
                                        TryGetRtspEndpoint(d.RtspUrl, out var frozenHost, out var _))
                                    {
                                        lock (_rtspHealthLock)
                                        {
                                            _rtspWasDown.Add($"{frozenHost}:{8554}");
                                        }
                                    }
                                }
                                else if (rtspFrozen && httpSaysRunning)
                                {
                                    // Android Agent는 RUNNING입니다.
                                    // WPF RTSP 타일만 멈춘 상태이므로 StreamState는 Agent 값을 유지합니다.
                                    d.StreamState = status.StreamState;
                                    d.AgentStoppedSinceUtc = DateTime.MinValue;

                                    d.MirrorError = "RTSP 영상 정지 감지 - 타일 재연결 중";

                                    string key = $"rtspfrozen:{d.AgentHost}";

                                    if (CanHardRestartRtsp(key, cooldownMs: 20_000))
                                    {
                                        Debug.WriteLine(
                                            $"[RtspFrozenActive] {d.Name} Agent={status.StreamState}, " +
                                            $"WPF RTSP frozen. WPF 타일만 재연결");

                                        _ = HardRestartRtspTileAsync(
                                            d,
                                            "RTSP frozen while Agent RUNNING: WPF tile reconnect only");
                                    }
                                }
                                else
                                {
                                    d.StreamState = status.StreamState;

                                    if (httpSaysRunning)
                                    {
                                        d.AgentStoppedSinceUtc = DateTime.MinValue;

                                        if (d.Rtsp?.IsFrozen != true)
                                            d.MirrorError = null;
                                    }
                                    else if (httpIsStarting)
                                    {
                                        d.MirrorError = "화면공유 준비 중";
                                    }
                                }
                            }

                            // generated Quest3_XXXX가 기존 사용자 이름을 덮어쓰지 않게 합니다.
                            ApplyResolvedAgentName(status, d);

                            // RTSP URL 변경 체크
                            if (!string.IsNullOrEmpty(status.RtspUrl))
                            {
                                bool urlChanged = !string.Equals(
                                    d.RtspUrl, status.RtspUrl,
                                    StringComparison.OrdinalIgnoreCase);

                                string prevUrl = d.RtspUrl;
                                d.RtspUrl = status.RtspUrl;

                                if (urlChanged && d.Rtsp != null)
                                {
                                    // URL이 바뀌면 쿨다운 없이 즉시 Dispose 후 재생성
                                    Debug.WriteLine(
                                        $"[RTSP] URL 변경 감지 {d.Name}: " +
                                        $"{prevUrl} → {status.RtspUrl}. 즉시 Dispose+Recreate");
                                    _ = ForceRecreateRtspTileAsync(d, "url-changed");
                                }
                            }

                            // frameAgeMs ≥ 8000ms: RUNNING인데 컴포지터가 너무 오래됨 → 실제 프리즈 또는 세션 실패
                            long encodedFrames = status.EncodedFrameCount ?? -1;
                            long lastFrameAtMs = status.LastFrameAtMs ?? -1;
                            long frameAgeMs = status.FrameAgeMs
                                ?? (lastFrameAtMs > 0
                                    ? DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - lastFrameAtMs
                                    : -1);
                            int rtspClients = status.RtspClientCount ?? -1;

                            Debug.WriteLine(
                                $"[Status] {d.Name} state={d.StreamState} vlcPlaying={d.Rtsp?.IsPlaying} vlcFrozen={d.Rtsp?.IsFrozen}");
                            _ = CheckRtspRecoveryAsync(d.Ip, d.RtspUrl, d.StreamState);
                            _ = CheckRtspClientStallAsync(d);

                            // ── Agent 프레임 상태 확인 ─────────────────────────────────────
                            // 중요: WPF는 Android 화면공유 자체를 재시작하지 않습니다.
                            // 화면공유 재시작은 Android AgentService 와치독이 담당합니다.
                            // WPF는 RTSP/VLC 타일 재연결만 수행합니다.
                            bool agentRunning = string.Equals(
                                d.StreamState, "RUNNING", StringComparison.OrdinalIgnoreCase);

                            if (agentRunning && d.Rtsp != null)
                            {
                                bool hasTelemetry =
                                    status.EncodedFrameCount.HasValue ||
                                    status.LastFrameAtMs.HasValue ||
                                    status.FrameAgeMs.HasValue;

                                if (!hasTelemetry)
                                {
                                    d.LastKnownEncodedFrameCount = -1;
                                    d.EncodedFrameCountSameAtUtc = DateTime.MinValue;
                                    d.RunningZeroFramesSinceUtc = DateTime.MinValue;
                                }
                                else
                                {
                                    long frames = status.EncodedFrameCount ?? -1;
                                    long lastFrMs = status.LastFrameAtMs ?? -1;
                                    long ageMs = status.FrameAgeMs
                                        ?? (lastFrMs > 0
                                            ? DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - lastFrMs
                                            : -1);

                                    if (frames > 0 || lastFrMs > 0)
                                    {
                                        // 프레임이 있으면 zero-frames 타이머 리셋
                                        d.RunningZeroFramesSinceUtc = DateTime.MinValue;

                                        // encodedFrameCount 정체 감지 (60초 이상)
                                        if (frames > 0)
                                        {
                                            if (d.LastKnownEncodedFrameCount != frames)
                                            {
                                                d.LastKnownEncodedFrameCount = frames;
                                                d.EncodedFrameCountSameAtUtc = DateTime.UtcNow;
                                            }
                                            else if (d.EncodedFrameCountSameAtUtc != DateTime.MinValue)
                                            {
                                                var stuckSec =
                                                    (DateTime.UtcNow - d.EncodedFrameCountSameAtUtc).TotalSeconds;
                                                if (stuckSec >= 60)
                                                {
                                                    string key = $"encstall:{d.AgentHost}";
                                                    if (CanHardRestartRtsp(key, cooldownMs: 60_000))
                                                    {
                                                        Debug.WriteLine(
                                                            $"[EncStall] {d.Name} frames={frames} " +
                                                            $"정체 {stuckSec:F0}초. " +
                                                            $"restartCapture 금지, WPF RTSP 타일만 재연결");
                                                        d.EncodedFrameCountSameAtUtc = DateTime.MinValue;
                                                        _ = HardRestartRtspTileAsync(
                                                            d,
                                                            "encoder count stalled: WPF tile reconnect only");
                                                    }
                                                }
                                            }
                                        }

                                        // frameAgeMs 60초 이상: WPF 타일만 재연결
                                        if (ageMs >= 60_000)
                                        {
                                            string key = $"frameage:{d.AgentHost}";
                                            if (CanHardRestartRtsp(key, cooldownMs: 60_000))
                                            {
                                                Debug.WriteLine(
                                                    $"[FrameAgeStall] {d.Name} frameAgeMs={ageMs}. " +
                                                    $"restartCapture 금지, WPF RTSP 타일만 재연결");
                                                _ = HardRestartRtspTileAsync(
                                                    d,
                                                    "frame age stale: WPF tile reconnect only");
                                            }
                                        }
                                        else if (ageMs >= 8_000 && d.Rtsp != null)
                                        {
                                            // 8초 이상 프레임이 안 오면 RTSP 세션이 죽은 것으로 판단
                                            // Dispose 후 재생성 (단순 재연결로는 복구 안 됨)
                                            string key = $"frameage8k:{d.AgentHost}";
                                            if (CanHardRestartRtsp(key, cooldownMs: 20_000))
                                            {
                                                Debug.WriteLine(
                                                    $"[FrameAge8k] {d.Name} frameAgeMs={ageMs} ≥ 8s. " +
                                                    $"ForceRecreate");
                                                _ = ForceRecreateRtspTileAsync(d, "frame-age-8k");
                                            }
                                        }
                                    }
                                    else
                                    {
                                        // RUNNING인데 frames=0: 30초 이상 지속 시 WPF 타일만 재연결
                                        // (5초는 너무 공격적 — Android와 충돌함)
                                        if (d.RunningZeroFramesSinceUtc == DateTime.MinValue)
                                        {
                                            d.RunningZeroFramesSinceUtc = DateTime.UtcNow;
                                        }
                                        else
                                        {
                                            var zeroSec =
                                                (DateTime.UtcNow - d.RunningZeroFramesSinceUtc).TotalSeconds;
                                            if (zeroSec >= 30)
                                            {
                                                string key = $"zeroframes:{d.AgentHost}";
                                                if (CanHardRestartRtsp(key, cooldownMs: 60_000))
                                                {
                                                    Debug.WriteLine(
                                                        $"[ZeroFrames] {d.Name} RUNNING {zeroSec:F0}초간 frames=0. " +
                                                        $"restartCapture 금지, WPF RTSP 타일만 재연결");
                                                    d.RunningZeroFramesSinceUtc = DateTime.MinValue;
                                                    _ = HardRestartRtspTileAsync(
                                                        d,
                                                        "zero frames: WPF tile reconnect only");
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            else
                            {
                                // RUNNING 아닐 때는 모든 트래킹 리셋
                                d.LastKnownEncodedFrameCount = -1;
                                d.EncodedFrameCountSameAtUtc = DateTime.MinValue;
                                d.RunningZeroFramesSinceUtc = DateTime.MinValue;
                            }
                        }
                    }
                });
            }
            finally
            {
                _isStatusCheckRunning = false;
            }
        }

        /// <summary>
        /// Agent가 보낸 이름과 WPF 보조 캐시를 결합해 최종 표시 이름을 결정합니다.
        ///
        /// - deviceNameSource=custom: Agent 이름을 신뢰하고 WPF에 저장
        /// - deviceNameSource=generated 또는 Quest3_XXXX: WPF 캐시/Settings 이름으로 복구
        /// - 구형 Agent: 명백한 자동 생성 이름이 아니면 사용자 이름으로 간주
        /// </summary>
        private void ApplyResolvedAgentName(
            QuestAgentInfo agent,
            Device device)
        {
            if (agent == null || device == null)
                return;

            string reportedName =
                agent.DeviceName?.Trim();

            string source =
                agent.DeviceNameSource?.Trim();

            string[] keys = BuildAgentNameCacheKeys(
                agent,
                device);

            bool explicitlyCustom =
                string.Equals(
                    source,
                    "custom",
                    StringComparison.OrdinalIgnoreCase);

            bool explicitlyGenerated =
                string.Equals(
                    source,
                    "generated",
                    StringComparison.OrdinalIgnoreCase) ||
                string.Equals(
                    source,
                    "default",
                    StringComparison.OrdinalIgnoreCase);

            bool looksGenerated =
                IsGeneratedAgentName(
                    reportedName,
                    agent,
                    device);

            bool customFromLegacyAgent =
                string.IsNullOrWhiteSpace(source) &&
                !string.IsNullOrWhiteSpace(reportedName) &&
                !looksGenerated;

            if (explicitlyCustom || customFromLegacyAgent)
            {
                device.Name = reportedName;
                _agentNameRecoveryStore.Put(keys, reportedName);

                Debug.WriteLine(
                    $"[NameRecovery] cache custom name: " +
                    $"deviceId={agent.DeviceId} name='{reportedName}' source={source}");

                return;
            }

            string recoveredName = null;

            if (_agentNameRecoveryStore.TryGet(keys, out string cachedName))
            {
                recoveredName = cachedName;
            }
            else if (!string.IsNullOrWhiteSpace(device.Serial) &&
                     _serialNameDic.TryGetValue(
                         device.Serial,
                         out string mappedName) &&
                     !string.IsNullOrWhiteSpace(mappedName))
            {
                recoveredName = mappedName.Trim();
                _agentNameRecoveryStore.Put(keys, recoveredName);
            }

            if (!string.IsNullOrWhiteSpace(recoveredName))
            {
                device.Name = recoveredName;

                // Agent 쪽 이름까지 복원하여 다음 PC/다음 검색에서도 동일하게 보이게 합니다.
                if (explicitlyGenerated ||
                    looksGenerated ||
                    string.IsNullOrWhiteSpace(reportedName))
                {
                    ScheduleAgentNameRestore(
                        agent,
                        device,
                        recoveredName,
                        keys);
                }

                return;
            }

            if (!string.IsNullOrWhiteSpace(reportedName))
            {
                device.Name = reportedName;
                return;
            }

            if (!string.IsNullOrWhiteSpace(agent.Model))
            {
                device.Name = agent.Model.Trim();
                return;
            }

            device.Name =
                !string.IsNullOrWhiteSpace(device.Serial)
                    ? device.Serial
                    : agent.Host ?? device.AgentHost ?? device.Ip;
        }

        private string[] BuildAgentNameCacheKeys(
            QuestAgentInfo agent,
            Device device)
        {
            var keys = new List<string>();

            if (!string.IsNullOrWhiteSpace(agent?.DeviceId))
                keys.Add("id:" + agent.DeviceId.Trim());

            string serial =
                !string.IsNullOrWhiteSpace(agent?.Serial)
                    ? agent.Serial.Trim()
                    : device?.Serial?.Trim();

            if (!string.IsNullOrWhiteSpace(serial) &&
                !string.Equals(serial, "UNKNOWN", StringComparison.OrdinalIgnoreCase))
            {
                keys.Add("serial:" + serial);
            }

            string host =
                !string.IsNullOrWhiteSpace(agent?.Host)
                    ? agent.Host.Trim()
                    : device?.AgentHost?.Trim();

            if (!string.IsNullOrWhiteSpace(host))
                keys.Add("host:" + host);

            return keys
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();
        }

        private static bool IsGeneratedAgentName(
            string name,
            QuestAgentInfo agent,
            Device device)
        {
            if (string.IsNullOrWhiteSpace(name))
                return true;

            string normalized = name.Trim();

            if (normalized.StartsWith(
                    "Quest3_",
                    StringComparison.OrdinalIgnoreCase) &&
                normalized.Length <= 24)
            {
                return true;
            }

            return
                string.Equals(normalized, agent?.Model, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(normalized, agent?.Host, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(normalized, agent?.Ip, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(normalized, agent?.Serial, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(normalized, agent?.DeviceId, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(normalized, device?.AgentHost, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(normalized, device?.Ip, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(normalized, device?.Serial, StringComparison.OrdinalIgnoreCase);
        }

        private void ScheduleAgentNameRestore(
            QuestAgentInfo agent,
            Device device,
            string recoveredName,
            IEnumerable<string> cacheKeys)
        {
            if (agent == null ||
                device == null ||
                string.IsNullOrWhiteSpace(device.AgentHost) ||
                string.IsNullOrWhiteSpace(recoveredName))
            {
                return;
            }

            string cooldownKey =
                cacheKeys?.FirstOrDefault() ??
                "host:" + device.AgentHost;

            DateTime now = DateTime.UtcNow;

            if (_agentNameRestoreCooldownUtc.TryGetValue(
                    cooldownKey,
                    out DateTime previous) &&
                (now - previous).TotalSeconds <
                    AgentNameRestoreCooldownSeconds)
            {
                return;
            }

            _agentNameRestoreCooldownUtc[cooldownKey] = now;

            int port =
                device.AgentStatusPort > 0
                    ? device.AgentStatusPort
                    : 18080;

            _ = Task.Run(async () =>
            {
                try
                {
                    bool restored =
                        await AgentApi.SetDeviceNameAsync(
                            device.AgentHost,
                            port,
                            recoveredName,
                            CancellationToken.None)
                        .ConfigureAwait(false);

                    Debug.WriteLine(
                        $"[NameRecovery] restore to Agent: " +
                        $"host={device.AgentHost}:{port} " +
                        $"name='{recoveredName}' restored={restored}");
                }
                catch (Exception ex)
                {
                    Debug.WriteLine(
                        $"[NameRecovery] restore failed: " +
                        $"host={device.AgentHost}:{port} " +
                        $"{ex.GetType().Name}: {ex.Message}");
                }
            });
        }

        private void OnChangeSerialName(IReadOnlyDictionary<string, string> serialNameDic)
        {
            // 최신 스냅샷으로 갱신 (저장 직후 반영 누락 방지)
            _serialNameDic = serialNameDic ?? new Dictionary<string, string>();

            foreach (var device in Devices)
            {
                if (_serialNameDic.TryGetValue(device.Serial, out var name))
                {
                    if (device.Name?.Equals(name, StringComparison.Ordinal) == true) continue;
                    device.Name = name;
                }
                else if (string.IsNullOrWhiteSpace(device.Name))
                {
                    // Agent/복구 캐시에서 이미 받은 이름은 유지합니다.
                    device.Name = device.Serial;
                }
            }
            // 이름 변경 즉시 UI 반영
            UpdateDeviceLabels();
        }

        // 디바이스 이름(Label) 즉시 반영
        private void UpdateDeviceLabels()
        {
            if (Tiles == null || Devices == null) return;
            foreach (var device in Devices)
            {
                var host = FindInItemTemplate<Border>(Tiles, device, "PART_MirrorHost");
                if (host == null) continue;
                var label = FindVisualChildByName<System.Windows.Controls.Label>(host, "DeviceNameLabel");
                if (label != null) label.Content = device.Name;
            }
        }

