        /// <summary>
        /// RTSP 하드 재시작 쿨다운 체크 (과도한 재시작 방지)
        /// </summary>
        private bool CanHardRestartRtsp(string key, int cooldownMs = 5000)
        {
            lock (_rtspHealthLock)
            {
                if (_lastRtspHardRestartUtc.TryGetValue(key, out var last))
                {
                    if ((DateTime.UtcNow - last).TotalMilliseconds < cooldownMs)
                        return false;
                }

                _lastRtspHardRestartUtc[key] = DateTime.UtcNow;
                return true;
            }
        }

        /// <summary>
        /// RTSP/VLC 프리즈 감지 시 호출 - Android Agent StreamState는 변경하지 않음.
        /// WPF 타일 상태(MirrorError)만 갱신하여 복구 조건이 꼬이지 않게 합니다.
        /// </summary>
        private void OnRtspFrozen(Device device)
        {
            var app = System.Windows.Application.Current;
            if (app is null) return;

            app.Dispatcher.InvokeAsync(() =>
            {
                // RTSP/VLC 프리즈는 Android Agent StreamState가 아닙니다.
                // 여기서 StreamState를 FROZEN으로 바꾸면
                // RUNNING 상태 기반 자동 복구 로직이 막힐 수 있습니다.
                device.MirrorError = "RTSP 영상 정지 감지 - 타일 재연결 대기 중";

                Debug.WriteLine(
                    $"[RtspFrozen] {device.Name} WPF RTSP frozen. " +
                    $"Agent StreamState는 변경하지 않음. current={device.StreamState}");
            });
        }

        /// <summary>
        /// RTSP 타일을 완전히 재생성하여 죽은 MediaPlayer 연결 복구
        /// (공유 재시작 시 URL은 같지만 세션이 끊긴 경우)
        /// </summary>
        private void HardRestartRtspTile(Device device, string reason)
        {
            // 동기 버전: 백그라운드 작업 시작 후 반환
            _ = HardRestartRtspTileAsync(device, reason);
        }

        /// <summary>
        /// RTSP 타일을 완전히 재생성하여 죽은 MediaPlayer 연결 복구 (비동기 버전)
        /// (공유 재시작 시 URL은 같지만 세션이 끊긴 경우)
        /// </summary>
        private async Task HardRestartRtspTileAsync(Device device, string reason)
        {
            if (device == null) return;
            if (string.IsNullOrWhiteSpace(device.RtspUrl)) return;

            string host = !string.IsNullOrWhiteSpace(device.AgentHost)
                ? device.AgentHost
                : GetHostOnly(device.Ip);

            if (string.IsNullOrWhiteSpace(host)) return;

            // 동시 HardRestart 차단
            lock (_rtspHealthLock)
            {
                if (_rtspRestartInProgress.Contains(host))
                {
                    Debug.WriteLine($"[RTSP] HardRestart 무시: {device.Name} 이미 재시작 진행 중");
                    return;
                }
                _rtspRestartInProgress.Add(host);
            }

            try
            {
                var oldAgent = device.Rtsp?.Agent;
                var agent = oldAgent ?? new QuestAgentInfo();

                agent.Host = host;
                agent.Ip = host;
                agent.StatusPort = device.AgentStatusPort > 0 ? device.AgentStatusPort : 18080;
                agent.RtspUrl = device.RtspUrl;
                agent.RtspPort = 8554;
                agent.Model = device.Name;
                agent.StreamState = "RUNNING";
                agent.Battery = device.BatteryLevel;

                Debug.WriteLine($"[RTSP] HardRestart: {device.Name}, reason={reason}, url={device.RtspUrl}");

                // Stop과 Dispose를 백그라운드 스레드에서 실행 (블로킹 방지)
                var oldRtsp = device.Rtsp;
                await Task.Run(() =>
                {
                    try { oldRtsp?.Stop(); } catch { }
                    try { oldRtsp?.Dispose(); } catch { }
                });

                // UI 스레드에서 새 ViewModel 생성
                RtspTileViewModel newRtsp = null;
                int activeStreams = 0;

                await Dispatcher.InvokeAsync(() =>
                {
                    string stallKey = $"stall:{host}";
                    int cnt;

                    lock (_rtspHealthLock)
                    {
                        _rtspHardRestartCounts.TryGetValue(stallKey, out cnt);
                        _rtspHardRestartCounts[stallKey] = ++cnt;
                    }

                    // 같은 기기에서 2회 이상 WPF 타일 재시작 발생 시
                    // GPU 디코딩 표면 문제로 보고 SW 디코딩 fallback 적용
                    bool useSoftwareDecode = cnt >= 2;

                    newRtsp = new RtspTileViewModel(
                        _rtspLibVlc,
                        agent,
                        _rtspQualityManager,
                        disableHardwareDecoding: useSoftwareDecode,
                        profile: _operationProfile);

                    if (useSoftwareDecode)
                        Debug.WriteLine($"[RTSP] HardRestart #{cnt}: {device.Name} SW 디코딩 fallback 적용");

                    newRtsp.FrozenDetected += (s, _) => OnRtspFrozen(device);
                    newRtsp.VideoAliveRestored += (s, _) =>
                    {
                        string k = $"stall:{host}";
                        lock (_rtspHealthLock) { _rtspHardRestartCounts.Remove(k); }
                        Debug.WriteLine($"[StallRecovery] {device.Name} 영상 신호 복구 → stall 카운트 리셋");
                    };
                    device.Rtsp = newRtsp;
                    activeStreams = Math.Max(1, Devices.Count(d => d.Rtsp != null));
                });

                await Dispatcher.InvokeAsync(() =>
                {
                    try
                    {
                        newRtsp?.Start(activeStreams);
                    }
                    catch (Exception ex)
                    {
                        Debug.WriteLine($"[RTSP] Start failed: {ex.Message}");
                    }
                });
            }
            finally
            {
                lock (_rtspHealthLock) { _rtspRestartInProgress.Remove(host); }
            }
        }

        /// <summary>
        /// RTSP URL 변경 또는 세션 완전 사망 시 호출.
        /// 기존 플레이어를 즉시 Dispose하고 700ms 후 새 URL로 재생성합니다.
        /// HardRestart와 달리 쿨다운·restartInProgress 체크를 우회합니다.
        /// </summary>
        private async Task ForceRecreateRtspTileAsync(Device device, string reason)
        {
            if (device == null) return;
            if (string.IsNullOrWhiteSpace(device.RtspUrl)) return;

            string host = !string.IsNullOrWhiteSpace(device.AgentHost)
                ? device.AgentHost
                : GetHostOnly(device.Ip);

            if (string.IsNullOrWhiteSpace(host)) return;

            // Serialize against HardRestartRtspTileAsync: prevent both from tearing down
            // the same native LibVLC player concurrently (→ AccessViolationException).
            lock (_rtspHealthLock)
            {
                if (_rtspRestartInProgress.Contains(host))
                {
                    Debug.WriteLine($"[RTSP] ForceRecreate 무시: {device.Name} 이미 재시작 진행 중");
                    return;
                }
                _rtspRestartInProgress.Add(host);
            }

            try
            {
                Debug.WriteLine($"[RTSP] ForceRecreate: {device.Name}, reason={reason}, url={device.RtspUrl}");

                // 1) 기존 플레이어 즉시 Dispose (백그라운드)
                var oldRtsp = device.Rtsp;
                await Task.Run(() =>
                {
                    try { oldRtsp?.Stop(); } catch { }
                    try { oldRtsp?.Dispose(); } catch { }
                });

                // UI 스레드에서 device.Rtsp 참조 제거
                await Dispatcher.InvokeAsync(() => device.Rtsp = null);

                // 2) 700ms 대기 (Android 측 새 RTSP 서버가 Listen 상태가 될 시간)
                await Task.Delay(700);

                if (string.IsNullOrWhiteSpace(device.RtspUrl)) return;

                // 3) 새 플레이어 생성 및 시작
                await Dispatcher.InvokeAsync(() =>
                {
                    if (string.IsNullOrWhiteSpace(device.RtspUrl)) return;

                    var agent = new QuestAgentInfo
                    {
                        Host = host,
                        Ip = host,
                        StatusPort = device.AgentStatusPort > 0 ? device.AgentStatusPort : 18080,
                        RtspUrl = device.RtspUrl,
                        RtspPort = 8554,
                        Model = device.Name,
                        StreamState = "RUNNING",
                        Battery = device.BatteryLevel
                    };

                    // URL 변경 재생성은 항상 HW 디코딩으로 리셋 (새 세션이므로)
                    string stallKey = $"stall:{host}";
                    lock (_rtspHealthLock) { _rtspHardRestartCounts.Remove(stallKey); }

                    var newRtsp = new RtspTileViewModel(
                        _rtspLibVlc,
                        agent,
                        _rtspQualityManager,
                        disableHardwareDecoding: false,
                        profile: _operationProfile);

                    newRtsp.FrozenDetected += (s, _) => OnRtspFrozen(device);
                    newRtsp.VideoAliveRestored += (s, _) =>
                    {
                        lock (_rtspHealthLock) { _rtspHardRestartCounts.Remove(stallKey); }
                    };

                    device.Rtsp = newRtsp;

                    int activeStreams = Math.Max(1, Devices.Count(d => d.Rtsp != null));
                    try { newRtsp.Start(activeStreams); }
                    catch (Exception ex)
                    {
                        Debug.WriteLine($"[RTSP] ForceRecreate Start failed: {ex.Message}");
                    }
                });
            } // end try
            finally
            {
                lock (_rtspHealthLock) { _rtspRestartInProgress.Remove(host); }
            }
        }

        /// <summary>
        /// Agent RUNNING 상태인데 WPF RTSP 플레이어가 첫 프레임/영상 신호를 못 받은 경우 자동 복구
        /// </summary>
        private async Task CheckRtspClientStallAsync(Device device)
        {
            if (device?.Rtsp == null) return;
            if (string.IsNullOrWhiteSpace(device.RtspUrl)) return;

            // RUNNING일 때만 stall 감지.
            // STARTING: 아직 준비 중이므로 stall 감지 대상 아님.
            // FROZEN/ERROR: Agent가 직접 restartCapture 하므로 WPF stall 감지 제외.
            bool streamRunning =
                string.Equals(device.StreamState, "RUNNING", StringComparison.OrdinalIgnoreCase);

            if (!streamRunning)
                return;

            if (!device.Rtsp.IsProbablyStalled()) return;

            string key = $"stall:{device.AgentHost}";

            // 호스트별 재시작 횟수 확인: 3회 이상이면 중단 (무한 루프 방지)
            int restartCount;
            lock (_rtspHealthLock)
            {
                _rtspHardRestartCounts.TryGetValue(key, out restartCount);
            }
            if (restartCount >= 3)
            {
                Debug.WriteLine($"[StallRecovery] {device.Name} 최대 재시도 횟수 도달. 자동 복구 중단.");
                return;
            }

            if (!CanHardRestartRtsp(key, cooldownMs: 20_000)) return;

            Debug.WriteLine(
                $"[StallRecovery] {device.Name} WPF player stalled. " +
                $"HardRestart only #{restartCount + 1} (Agent capture 재시작 안 함)");

            // WPF 플레이어 문제와 Agent Capture 문제를 분리.
            // RestartCaptureAsync를 여기서 호출하면:
            //   RTSP 서버 재생성 → VLC 재연결 → stall 재감지 → 무한 루프
            // WPF 타일만 재생성하여 VLC가 현재 RTSP 세션에 다시 붙게 합니다.
            await HardRestartRtspTileAsync(device, "client stall: WPF player restart only");
        }

        /// <summary>
        /// Agent streamState 복구 감지 시 RTSP 타일 자동 하드 재시작
        /// RTSP 포트에 직접 TCP 접속하지 않고 Agent 상태값만 사용합니다.
        /// </summary>
        private async Task CheckRtspRecoveryAsync(
            string ip,
            string rtspUrl,
            string streamState)
        {
            if (string.IsNullOrWhiteSpace(rtspUrl))
                return;

            if (!TryGetRtspEndpoint(rtspUrl, out var rtspHost, out var rtspPort))
                return;

            string key = $"{rtspHost}:{rtspPort}";

            // RUNNING만 활성 상태로 간주.
            // STARTING: 아직 준비 중이므로 down으로 기록합니다. RUNNING으로 전환될 때 HardRestart합니다.
            // FROZEN, ERROR, STOPPED, IDLE 시에는 _rtspWasDown에 등록 →
            // Agent가 RUNNING으로 복구될 때 HardRestart를 합니다.
            bool isStreaming =
                string.Equals(streamState, "RUNNING", StringComparison.OrdinalIgnoreCase);

            // RTSP 포트에 직접 TCP 연결하지 않습니다.
            // Agent가 RUNNING이 아니면 down으로 기록만 합니다.
            if (!isStreaming)
            {
                lock (_rtspHealthLock)
                {
                    _rtspWasDown.Add(key);
                }

                return;
            }

            bool shouldRestart = false;

            lock (_rtspHealthLock)
            {
                if (_rtspWasDown.Contains(key))
                {
                    _rtspWasDown.Remove(key);
                    shouldRestart = true;
                }
            }

            if (!shouldRestart)
                return;

            if (!CanHardRestartRtsp(key, cooldownMs: 12000))
                return;

            await Dispatcher.InvokeAsync(() =>
            {
                var device = Devices.FirstOrDefault(d =>
                    string.Equals(d.Ip, ip, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(d.AgentHost, rtspHost, StringComparison.OrdinalIgnoreCase));

                if (device != null)
                {
                    HardRestartRtspTile(device, "RTSP recovered by Agent streamState");
                }
            });
        }


        public async Task<List<(string ip, int port)>> ScanPortsAsync(
            List<string> ips, int portStart, int portEnd, IProgress<int> progress = null, CancellationToken token = default)
        {
            var openPorts = new ConcurrentBag<(string, int)>();
            int maxParallel = 400;
            var throttler = new SemaphoreSlim(maxParallel);
            var tasks = new List<Task>();
            int completed = 0, totalPort = ips.Count * (portEnd - portStart + 1);
            int reportInterval = Math.Max(totalPort / 100, 1);

            try
            {
                // 가능성 높은 5555 선탐색
                foreach (var ip in ips)
                {
                    if (token.IsCancellationRequested) break;
                    await throttler.WaitAsync(token);
                    tasks.Add(Task.Run(async () =>
                    {
                        try
                        {
                            if (await TryConnectPort(ip, 5555, token))
                                openPorts.Add((ip, 5555));
                        }
                        catch { }
                        finally
                        {
                            int done = Interlocked.Increment(ref completed);
                            if (done % reportInterval == 0 || done == totalPort)
                                progress?.Report(done);
                            throttler.Release();
                        }
                    }, token));
                }

                // 범위 스캔
                foreach (var ip in ips)
                {
                    for (int port = portStart; port <= portEnd; port++)
                    {
                        if (port == 5555) continue;
                        if (token.IsCancellationRequested) break;
                        await throttler.WaitAsync(token);
                        var t = ScanPortAsync(ip, port, openPorts, throttler, () =>
                        {
                            int done = Interlocked.Increment(ref completed);
                            if (done % reportInterval == 0 || done == totalPort)
                                progress?.Report(done);
                        }, token);
                        tasks.Add(t);
                    }
                }
                await Task.WhenAll(tasks);
            }
            catch (OperationCanceledException) { }
            return openPorts.ToList();
        }

        private async Task ScanPortAsync(string ip, int port, ConcurrentBag<(string, int)> openPorts, SemaphoreSlim throttler, Action onComplete, CancellationToken token)
        {
            try
            {
                if (token.IsCancellationRequested) return;
                if (await TryConnectPort(ip, port, token))
                    openPorts.Add((ip, port));
            }
            catch { }
            finally
            {
                onComplete?.Invoke();
                throttler.Release();
            }
        }

        private static async Task<bool> TryConnectPort(string ip, int port, CancellationToken token)
        {
            try
            {
                using var client = new TcpClient();
                var connectTask = client.ConnectAsync(ip, port);
                var timeoutTask = Task.Delay(200, token); // 150→200ms: 포트 탄지 실패륙 감소
                var completedTask = await Task.WhenAny(connectTask, timeoutTask);
                return completedTask == connectTask && client.Connected;
            }
            catch { return false; }
        }

