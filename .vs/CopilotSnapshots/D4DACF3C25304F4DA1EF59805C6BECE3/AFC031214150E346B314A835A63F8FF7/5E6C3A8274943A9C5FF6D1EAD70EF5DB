                device.AgentStatusPort > 0
                    ? device.AgentStatusPort
                    : 18080;

            return AgentApi.StopAllStoryWingFastDetailedAsync(
                host: device.AgentHost,
                port: port,
                goHome: false,
                retryCount: 3,
                retryIntervalMs: 1_000,
                goHomeDelayMs: 0,
