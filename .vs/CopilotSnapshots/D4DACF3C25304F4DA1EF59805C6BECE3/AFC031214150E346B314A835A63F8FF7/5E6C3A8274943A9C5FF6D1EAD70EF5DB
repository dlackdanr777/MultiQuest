        /// <summary>
        /// 코딩/영어 전용 신뢰성 파이프라인입니다.
        /// 1) Activity launch extras 전달
        /// 2) Agent가 동일 payload를 manifest receiver로 4회 재전송
        /// 3) Unity 플러그인의 COMMAND_ACK를 operationId로 확인
        /// </summary>
        private async Task ExecuteReliableContentFleetAsync(
            IReadOnlyList<Device> targetDevices,
            string[] candidates,
            string command,
            Dictionary<string, object> payload,
            string resultTitle)
        {
            if (_isFleetLaunchRunning)
            {
                ShowMsg("다른 전체 실행/콘텐츠 명령이 이미 진행 중입니다.");
                return;
            }

            if (targetDevices == null || targetDevices.Count == 0)
            {
                ShowMsg("명령을 보낼 Agent 기기가 없습니다.");
                return;
            }

            _isFleetLaunchRunning = true;
            this.IsEnabled = false;

            _fleetLaunchCancelSource?.Cancel();
            _fleetLaunchCancelSource?.Dispose();
            _fleetLaunchCancelSource = new CancellationTokenSource();

            bool statusTimerWasEnabled =
                _statusCheckTimer?.IsEnabled == true;
            _statusCheckTimer?.Stop();

            var stopwatch = Stopwatch.StartNew();
            string batchId = Guid.NewGuid().ToString("N");

            using var totalCts =
                CancellationTokenSource.CreateLinkedTokenSource(
                    _fleetLaunchCancelSource.Token);

            totalCts.CancelAfter(FleetContentTotalTimeoutMs);

            var results =
                new ConcurrentBag<ContentDispatchResult>();

            try
            {
                Task[] tasks = targetDevices
                    .Select(device =>
                        DispatchContentToDeviceAsync(
                            device,
                            candidates,
                            command,
                            payload,
                            batchId,
                            results,
                            totalCts.Token))
                    .ToArray();

                await Task.WhenAll(tasks);
                stopwatch.Stop();

                ContentDispatchResult[] ordered = results
                    .OrderBy(x => x.Device?.Name)
                    .ThenBy(x => x.Device?.AgentHost)
                    .ToArray();

                int verified =
                    ordered.Count(x => x.Verified);

                int dispatched =
                    ordered.Count(x =>
                        x.Dispatched &&
                        !x.Verified);

                int failed =
                    ordered.Length -
                    verified -
                    dispatched;

                string details = string.Join(
                    "\n",
                    ordered
                        .Where(x => !x.Dispatched)
                        .Select(x =>
                            $"- {x.Device?.Name} ({x.Device?.AgentHost}) " +
                            $"[{x.State}] {x.Message}"));

                ShowMsg(
                    $"{resultTitle} 명령 결과\n\n" +
                    $"앱 ACK 확인: {verified}대\n" +
                    $"Agent 전송 접수: {dispatched}대\n" +
                    $"명시적 실패: {failed}대\n" +
                    $"대상: {targetDevices.Count}대\n" +
                    $"소요 시간: {stopwatch.Elapsed.TotalSeconds:F2}초" +
                    (string.IsNullOrWhiteSpace(details)
                        ? ""
                        : $"\n\n[전송 실패]\n{details}"));
            }
            catch (OperationCanceledException)
            {
                stopwatch.Stop();
                ShowMsg(
                    $"{resultTitle} 명령 제한 시간 초과\n" +
                    $"소요 시간: {stopwatch.Elapsed.TotalSeconds:F2}초\n" +
                    "일부 기기는 launch extras 또는 재전송 방송을 이미 받았을 수 있습니다.");
            }
            catch (Exception ex)
            {
                stopwatch.Stop();
                ShowMsg(
                    $"{resultTitle} 명령 중 오류\n" +
                    $"{ex.GetType().Name}: {ex.Message}");
            }
            finally
            {
                _fleetLaunchCancelSource?.Dispose();
                _fleetLaunchCancelSource = null;
                _isFleetLaunchRunning = false;

                if (statusTimerWasEnabled && !_isShuttingDown)
                    _statusCheckTimer?.Start();

                this.IsEnabled = true;
            }
        }

        private async Task DispatchContentToDeviceAsync(
            Device device,
            string[] candidates,
            string command,
            Dictionary<string, object> payload,
            string batchId,
            ConcurrentBag<ContentDispatchResult> results,
            CancellationToken cancellationToken)
        {
            bool gateEntered = false;

            try
            {
                await _fleetContentGate
                    .WaitAsync(cancellationToken)
                    .ConfigureAwait(false);

                gateEntered = true;

                string deviceKey =
                    !string.IsNullOrWhiteSpace(
                        device?.AgentDeviceId)
                        ? device.AgentDeviceId
                        : device?.AgentHost
                          ?? "unknown";

                string requestId =
                    $"{batchId}:{deviceKey}:{command}";

                string[] normalizedCandidates =
                    candidates?
                        .Where(packageName =>
                            !string.IsNullOrWhiteSpace(
                                packageName))
                        .Select(packageName =>
                            packageName.Trim())
                        .Distinct(
                            StringComparer.OrdinalIgnoreCase)
                        .ToArray()
                    ?? Array.Empty<string>();

                if (normalizedCandidates.Length == 0)
                {
                    results.Add(
                        new ContentDispatchResult
                        {
                            Device = device,
                            Dispatched = false,
                            Verified = false,
                            State = "NO_PACKAGE",
                            Message =
                                "콘텐츠 앱 패키지 후보가 없습니다."
                        });

                    return;
                }

                var launchPayload =
                    new Dictionary<string, object>(
                        payload ??
                        new Dictionary<string, object>(),
                        StringComparer.OrdinalIgnoreCase)
                    {
                        ["requestId"] = requestId,
                        ["command"] = command,
                        ["issuedAtMs"] =
                            DateTimeOffset.UtcNow
                                .ToUnixTimeMilliseconds()
                    };

                var commandPayload =
                    new Dictionary<string, object>(
                        payload ??
                        new Dictionary<string, object>(),
                        StringComparer.OrdinalIgnoreCase)
                    {
                        ["requestId"] = requestId,
                        ["command"] = command
                    };

                /*
                 * 핵심 변경:
                 *
                 * 기존:
                 * launch 응답 완료
                 * → appCommand 전송
                 *
                 * 문제:
                 * 일부 Quest의 launch HTTP가 늦으면 6.5초 전체 제한이 먼저
                 * 끝나 appCommand가 Agent에 전혀 도착하지 않았습니다.
                 *
                 * 수정:
                 * launch와 appCommand 예약을 동시에 시작합니다.
                 * Agent는 appCommand를 0~16초 동안 로컬 재전송하므로,
                 * 앱이 아직 실행 중이어도 명령을 먼저 예약해도 안전합니다.
                 */
                Task<DeviceAppLaunchResult> launchTask =
                    LaunchCandidatesByAgentFastAsync(
                        device,
                        normalizedCandidates,
                        launchPayload,
                        cancellationToken);

                _ = ObserveContentLaunchInBackgroundAsync(
                    device,
                    launchTask,
                    requestId);

                Task<(
                    AgentCommandReply Reply,
                    string PackageName)>
                    commandTask =
                        QueueContentCommandForCandidatesAsync(
                            device,
                            normalizedCandidates,
                            command,
                            commandPayload,
                            requestId,
                            cancellationToken);

                (
                    AgentCommandReply commandReply,
                    string commandPackageName) =
                        await commandTask
                            .ConfigureAwait(false);

                /*
                 * WPF 결과창은 Agent의 콘텐츠 재전송 예약 여부를 기준으로
                 * 즉시 반환합니다. launch 결과는 위 백그라운드 관찰자가
                 * 별도로 기록합니다.
                 */
                bool accepted =
                    commandReply?.IsAcceptedSuccess == true;

                bool deliveryUncertain =
                    commandReply?.IsDeliveryUncertain == true;

                bool dispatched =
                    accepted ||
                    deliveryUncertain;

                string state =
                    accepted
                        ? "RETRY_SEQUENCE_QUEUED"
                        : deliveryUncertain
                            ? "DELIVERY_UNCERTAIN"
                            : commandReply?.Error ??
                              commandReply?.State ??
                              "APP_COMMAND_REJECTED";

                string message =
                    accepted
                        ? "Agent가 0~16초 콘텐츠 재전송을 예약했습니다."
                        : deliveryUncertain
                            ? "Agent 응답은 확인되지 않았지만 동일 requestId로 " +
                              "HTTP 재시도를 완료했습니다."
                            : commandReply?.Message ??
                              "Agent가 콘텐츠 명령 예약을 거부했습니다.";

                Debug.WriteLine(
                    $"[ContentAgentQueue] " +
                    $"device={device?.Name} " +
                    $"host={device?.AgentHost}:" +
                    $"{(device?.AgentStatusPort > 0 ? device.AgentStatusPort : 18080)} " +
                    $"package={commandPackageName} " +
                    $"accepted={accepted} " +
                    $"deliveryUncertain={deliveryUncertain} " +
                    $"operationId={commandReply?.OperationId} " +
                    $"requestId={requestId}");

                results.Add(
                    new ContentDispatchResult
                    {
                        Device = device,
                        PackageName =
                            commandPackageName,
                        Dispatched =
                            dispatched,
                        Verified =
                            commandReply?.Completed == true,
                        State = state,
                        Message = message
                    });
            }
            catch (OperationCanceledException)
            {
                results.Add(
                    new ContentDispatchResult
                    {
                        Device = device,
                        Dispatched = false,
                        Verified = false,
                        State = "TIMEOUT",
                        Message =
                            "9초 안에 Agent 콘텐츠 재전송 예약을 확인하지 못했습니다."
                    });
            }
            catch (Exception ex)
            {
                results.Add(
                    new ContentDispatchResult
                    {
                        Device = device,
                        Dispatched = false,
                        Verified = false,
                        State = "CLIENT_EXCEPTION",
                        Message =
                            $"{ex.GetType().Name}: " +
                            $"{ex.Message}"
                    });
            }
            finally
            {
                if (gateEntered)
                {
                    _fleetContentGate.Release();
                }
            }
        }

        /// <summary>
        /// 패키지 후보가 2개인 영어 앱도 설치된 후보 하나를 찾아
        /// appCommand 재전송 시퀀스를 예약합니다.
        ///
        /// AgentApi는 같은 requestId로 HTTP 확인 요청을 최대 2회 보내며,
        /// Agent는 중복 requestId를 하나의 operation으로 합칩니다.
        /// </summary>
        private async Task<(
            AgentCommandReply Reply,
            string PackageName)>
            QueueContentCommandForCandidatesAsync(
                Device device,
                IReadOnlyList<string> candidates,
                string command,
                Dictionary<string, object> payload,
                string requestId,
                CancellationToken cancellationToken)
        {
            if (device == null ||
                string.IsNullOrWhiteSpace(
                    device.AgentHost))
            {
                return (
                    new AgentCommandReply
                    {
                        Ok = false,
                        Accepted = false,
                        Completed = false,
                        Retryable = false,
                        Error = "invalid_device",
                        Message =
                            "AgentHost가 없습니다."
                    },
                    null);
            }

            int port =
                device.AgentStatusPort > 0
                    ? device.AgentStatusPort
                    : 18080;

            AgentCommandReply lastReply = null;
            string lastPackageName = null;

            foreach (string packageName
                     in candidates)
            {
                cancellationToken
                    .ThrowIfCancellationRequested();

                lastPackageName =
                    packageName;

                AgentCommandReply reply =
                    await AgentApi
                        .SendReliableAppCommandDetailedAsync(
                            host: device.AgentHost,
                            port: port,
                            packageName: packageName,
                            command: command,
                            args: payload,
                            requestId: requestId,
                            retryCount:
                                ContentCommandRetryCount,
                            retryIntervalMs:
                                ContentCommandRetryIntervalMs,
                            cancellationToken:
                                cancellationToken)
                        .ConfigureAwait(false);

                lastReply =
                    reply;

                Debug.WriteLine(
                    $"[ContentCandidateQueue] " +
                    $"device={device.Name} " +
                    $"host={device.AgentHost}:{port} " +
                    $"package={packageName} " +
                    $"accepted={reply?.IsAcceptedSuccess} " +
                    $"uncertain={reply?.IsDeliveryUncertain} " +
                    $"retryable={reply?.Retryable} " +
                    $"error={reply?.Error} " +
                    $"requestId={requestId}");

                if (reply?.IsAcceptedSuccess == true ||
                    reply?.IsDeliveryUncertain == true)
                {
                    return (
                        reply,
                        packageName);
                }

                /*
                 * 첫 번째 영어 패키지가 설치되지 않은 경우 다음 후보를
                 * 즉시 시도합니다. 다른 명시적 실패도 후보별 패키지 차이일
                 * 수 있으므로 다음 후보가 있으면 계속 진행합니다.
                 */
            }

            return (
                lastReply ??
                new AgentCommandReply
                {
                    Ok = false,
                    Accepted = false,
                    Completed = false,
                    Retryable = false,
                    Error = "no_candidate_accepted",
                    Message =
                        "설치된 콘텐츠 앱 후보를 찾지 못했습니다."
                },
                lastPackageName);
        }

