<Window x:Class="MultiQuest_Management.DeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MultiQuest_Management"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Single Mirror - MultiQuest Management"
        Height="700" Width="1200"
        Background="#0E1116"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- ================== 글로벌 리소스(팔레트/스타일) ================== -->
    <Window.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="Bg0" Color="#0E1116"/>
        <SolidColorBrush x:Key="Bg1" Color="#121722"/>
        <SolidColorBrush x:Key="Card" Color="#141A24"/>
        <SolidColorBrush x:Key="Card2" Color="#0F1622"/>
        <SolidColorBrush x:Key="Stroke" Color="#223047"/>
        <SolidColorBrush x:Key="Accent" Color="#5BD5FF"/>
        <SolidColorBrush x:Key="Accent2" Color="#7C5BFF"/>
        <SolidColorBrush x:Key="Ok" Color="#3CE48C"/>
        <SolidColorBrush x:Key="Bad" Color="#FF5963"/>
        <SolidColorBrush x:Key="Text" Color="#D8E2F1"/>
        <SolidColorBrush x:Key="TextDim" Color="#9DB0C9"/>

        <!-- 아이콘 카드 -->
        <Style x:Key="IconCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000" BlurRadius="16" ShadowDepth="2" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 슬롯(타일) 카드 -->
        <Style x:Key="TileCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="{StaticResource Card2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 미러 표면 -->
        <Style x:Key="MirrorSurface" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#253447"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D1420" Offset="0"/>
                        <GradientStop Color="#0B1019" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 네온 버튼 -->
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A2F3C" Offset="0"/>
                        <GradientStop Color="#1A2230" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#2B3B56"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="14"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="neon" CornerRadius="14" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#5BD5FF" Offset="0"/>
                                        <GradientStop Color="#7C5BFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.BorderThickness>2</Border.BorderThickness>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="neon" Property="Opacity" Value="1"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#3E5F8C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 네온 미니 버튼 -->
        <Style x:Key="NeonMini" BasedOn="{StaticResource NeonButton}" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <!-- 헤더 텍스트 -->
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <!-- ================== 본문 레이아웃 ================== -->
    <DockPanel>
        <!-- (상단 메뉴 제거됨) -->

        <!-- 좌: 단일 미러  /  우: 아이콘+정지 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <!-- Left: 미러 전체 -->
                <ColumnDefinition Width="268"/>
                <!-- Right: 컨트롤 패널 -->
            </Grid.ColumnDefinitions>

            <!-- ====== Left: Single Mirror ====== -->
            <Grid Grid.Column="0" Margin="10,20,10,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 헤더 -->
                    <RowDefinition/>
                    <!-- 미러 영역 -->
                </Grid.RowDefinitions>

                <!-- 헤더(상태/이름/IP + 배터리 + Refresh) -->
                <Grid Grid.Row="0" Margin="10,0,10,8" MinHeight="30" VerticalAlignment="Center"
                      DataContext="{Binding CurrentDevice}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 첫 번째 행: 상태점/이름/IP -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="20" Height="20" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Bad}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Ok}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                        <TextBlock Text="•" Foreground="#314B6D" Margin="6,0,6,0"/>
                        <TextBlock Text="{Binding Ip, StringFormat= (IP {0})}"
                                   Foreground="#6482A7" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- 두 번째 행: 기기 제어 버튼 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,6,0,6">
                        <Button Content="🔄 Reboot"
                                Click="RebootDeviceBtn_Click"
                                Width="90" Height="28"
                                Margin="0,0,8,0"
                                FontSize="11" FontWeight="SemiBold"
                                Style="{StaticResource NeonButton}"
                                Foreground="{StaticResource Accent}" />

                        <Button Content="⏻ Shutdown"
                                Click="ShutdownDeviceBtn_Click"
                                Width="100" Height="28"
                                FontSize="11" FontWeight="SemiBold"
                                Style="{StaticResource NeonButton}"
                                Foreground="{StaticResource Bad}" />
                    </StackPanel>

                    <!-- 세 번째 행: 품질 정보 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,4,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRtsp}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Background="#1A2332" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Foreground="#5BD5FF" FontSize="11" FontWeight="SemiBold">
                                <Run Text="품질: "/>
                                <Run Text="{Binding Rtsp.QualityLevel, Mode=OneWay}" Foreground="#FFFFFF"/>
                            </TextBlock>
                        </Border>

                        <Border Background="#1A2332" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Foreground="#FFD700" FontSize="11" FontWeight="SemiBold">
                                <Run Text="버퍼링: "/>
                                <Run Text="{Binding Rtsp.BufferingRate, StringFormat={}{0:F1}%, Mode=OneWay}" Foreground="#FFFFFF"/>
                            </TextBlock>
                        </Border>

                        <Border Background="#1A2332" CornerRadius="6" Padding="8,4">
                            <TextBlock Foreground="#3CE48C" FontSize="11" FontWeight="SemiBold">
                                <Run Text="캐싱: "/>
                                <Run Text="{Binding Rtsp.NetworkCaching, StringFormat={}{0}ms, Mode=OneWay}" Foreground="#FFFFFF"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- 오른쪽: 배터리 + Refresh (두 행에 걸쳐서) -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 배터리 표시: 번개(왼쪽) + 배터리 이미지(퍼센트 내장) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <!-- 충전 아이콘 (⚡) - 배터리 왼쪽 -->
                            <TextBlock Text="⚡" 
                                       FontSize="14"
                                       Foreground="#FFD700"
                                       VerticalAlignment="Center"
                                       Margin="0,0,2,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 배터리 이미지 + 퍼센트 오버레이 -->
                            <Grid Width="36" Height="36" VerticalAlignment="Center">
                                <!-- 배터리 이미지 -->
                                <Image Source="Images/Battery.png" 
                                       Stretch="Fill"/>

                                <!-- 배터리 퍼센트 - 중앙 -->
                                <TextBlock Text="{Binding BatteryLevel, StringFormat={}{0}%}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Text}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           TextAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Button Content="Refresh"
                                Style="{StaticResource NeonMini}"
                                VerticalAlignment="Center"
                                Click="RefreshTile_Click"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>

                <!-- 미러 호스트: RTSP VideoView -->
                <Border Grid.Row="1"
                        Style="{StaticResource MirrorSurface}">
                    <Grid x:Name="PART_MirrorHost">
                        <!-- RTSP 비디오 뷰 -->
                        <vlc:VideoView x:Name="RtspVideoView"
                                       Background="#0B1019"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"/>

                        <!-- 로딩/상태 오버레이 -->
                        <Border x:Name="StatusOverlay"
                                Background="#CC0E1116"
                                Visibility="Collapsed"
                                CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusText"
                                           Text="연결 중..."
                                           Foreground="{StaticResource Text}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====== Right: 컨트롤 패널 ====== -->
            <Grid Grid.Column="1" Margin="0,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 상단 라벨 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 아이콘 카드 -->
                    <RowDefinition/>
                    <!-- Spacer -->
                    <RowDefinition Height="Auto"/>
                    <!-- All Device Stop -->
                </Grid.RowDefinitions>

                <!-- 상단 설명 텍스트 -->
                <Label x:Name="All_Device_Start_Menu_Text" Content="                  Device Start Menus"
                       Foreground="{StaticResource TextDim}"
                       Background="{x:Null}" BorderBrush="{x:Null}" />

                <!-- 아이콘 카드 -->
                <Border Grid.Row="1" Style="{StaticResource IconCard}" Margin="0,8,0,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Grid x:Name="IconButtonGrid" Width="190" Height="475">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- Tag=0: 영어마을 -->
                        <Button Grid.Row="0" Grid.Column="0" Margin="1" Click="StartAppBtn_Click" Tag="0" Background="#00000000" BorderBrush="#00707070">
                            <Image Source="Images/EnglishTown.png" Stretch="UniformToFill"/>
                        </Button>
                        <!-- Tag=1: 해양탐험 -->
                        <Button Grid.Row="0" Grid.Column="1" Margin="1" Click="StartAppBtn_Click" Tag="1" Background="#00000000" BorderBrush="#00707070">
                            <Image Source="Images/OceanAdventure.png" Stretch="UniformToFill"/>
                        </Button>
                        <!-- Tag=2: 한국사 -->
                        <Button Grid.Row="1" Grid.Column="0" Margin="1" Click="StartAppBtn_Click" Tag="2" Background="#00000000" BorderBrush="#00707070">
                            <Image Source="Images/KoreaHistory.png" Stretch="UniformToFill"/>
                        </Button>
                        <!-- Tag=3: 태양계 -->
                        <Button Grid.Row="1" Grid.Column="1" Margin="1" Click="StartAppBtn_Click" Tag="3" Background="#00000000" BorderBrush="#00707070">
                            <Image Source="Images/SolarSystem.png" Stretch="UniformToFill"/>
                        </Button>
                        <!-- Tag=4: 소방안전 -->
                        <Button Grid.Row="2" Grid.Column="0" Margin="1" Click="StartAppBtn_Click" Tag="4" Background="#00000000" BorderBrush="#00707070">
                            <Image Source="Images/FireSafety.png" Stretch="UniformToFill"/>
                        </Button>
                        <!-- Tag=5: 쥬라기공원 -->
                        <Button Grid.Row="2" Grid.Column="1" Margin="1" Click="StartAppBtn_Click" Tag="5" Background="#00000000" BorderBrush="#00707070">
                            <Image Source="Images/Jurassic.png" Stretch="UniformToFill"/>
                        </Button>
                        <!-- Tag=6: 브레인팝 -->
                        <Button Grid.Row="3" Grid.Column="0" Margin="1" Click="StartAppBtn_Click" Tag="6" Background="#00000000" BorderBrush="#00707070">
                            <Image Source="/BrainPop.png" Stretch="UniformToFill"/>
                        </Button>
                        <!-- Tag=7: 스마트팜 -->
                        <Button Grid.Row="3" Grid.Column="1" Margin="1" Click="StartAppBtn_Click" Tag="7" Background="#00000000" BorderBrush="#00707070">
                            <Image Source="Images/SmartFarm.png" Stretch="UniformToFill"/>
                        </Button>
                        <!-- Tag=8: 박물관 -->
                        <Button Grid.Row="4" Grid.Column="0" Margin="1" Click="StartAppBtn_Click" Tag="8" Background="#00000000" BorderBrush="#00707070">
                            <Image Source="Images/Musium.png" Stretch="UniformToFill"/>
                        </Button>
                        <!-- Tag=9: 세계여행 -->
                        <Button Grid.Row="4" Grid.Column="1" Margin="1" Click="StartAppBtn_Click" Tag="9" Background="#00000000" BorderBrush="#00707070">
                            <Image Source="Images/WorldMap.png" Stretch="UniformToFill"/>
                        </Button>

                    </Grid>
                </Border>

                <!-- Device Stop -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="Stop App"
                            Click ="StopAppBtn_Click"
                            Width="212" Height="50"
                            Margin="0,0,0,8"
                            FontSize="20" FontWeight="Bold"
                            Style="{StaticResource NeonButton}"
                            Foreground="{StaticResource Bad}" />

                    <Button Content="Reboot Device"
                            Click ="RebootDeviceBtn_Click"
                            Width="212" Height="50"
                            Margin="0,0,0,8"
                            FontSize="18" FontWeight="Bold"
                            Style="{StaticResource NeonButton}"
                            Foreground="{StaticResource Accent}" />

                    <Button Content="Shutdown Device"
                            Click ="ShutdownDeviceBtn_Click"
                            Width="212" Height="50"
                            FontSize="18" FontWeight="Bold"
                            Style="{StaticResource NeonButton}"
                            Foreground="{StaticResource Bad}" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
