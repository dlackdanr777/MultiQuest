        // scrcpy crop은 짝수 픽셀 필요
        private static int Even(int v) { v = Math.Max(2, v); return v % 2 == 0 ? v : v - 1; }

        /// <summary>
        /// (w, h, x, y) 사각형을 타일 비율(tileW:tileH)에 맞게 중앙 crop 해 반환한다.
        /// tileW/tileH가 0이면 16:9로 처리한다.
        /// </summary>
        private static (int w, int h, int x, int y) CropToRatio(int w, int h, int x, int y, int tileW, int tileH)
        {
            double target = (tileW > 0 && tileH > 0) ? (double)tileW / tileH : 16.0 / 9.0;
            w = Even(w); h = Even(h); x = Even(x); y = Even(y);
            double ratio = (double)w / h;
            if (ratio > target)          // 너무 넓음 → 좌우 자름
            {
                int nw = Even((int)Math.Floor(h * target));
                x = Even(x + (w - nw) / 2); w = nw;
            }
            else if (ratio < target)     // 너무 높음 → 상하 자름
            {
                int nh = Even((int)Math.Floor(w / target));
                y = Even(y + (h - nh) / 2); h = nh;
            }
            return (w, h, x, y);
        }

        /// <summary>
        /// 기기 모델을 감지해 좌안 crop 파라미터와 angle 인수를 반환한다.
        /// Quest 3 / Quest 3S : 좌안 전체(eyeW × eyeH)를 타일 비율로 중앙 crop + --angle=22
        /// 미지 기기           : 동일 처리, angle 없음
        /// tileW/tileH = 0 이면 16:9 기준 적용
        /// </summary>
        private (int cropW, int cropH, int cropX, int cropY, string angleArg) GetQuestCropSettings(
            string deviceIp, int tileW = 0, int tileH = 0)
        {
            var (screenW, screenH) = GetDeviceScreenSize(deviceIp);
            int eyeW = screenW / 2;
            int eyeH = screenH;

            string model = "quest"; // Default to Quest for calculations

            // 좌우 추가 trim 비율 — 좌안 버퍼 양쪽의 검정/렌즈 영역 제거 (0.0 ~ 0.4)
            const double extraHCrop = 0.15;

            static (int w, int h, int x, int y) ApplyExtraAndRefit(
                int cw, int ch, int cx, int cy,
                double extra, int tw, int th)
            {
                // 1) 좌우 추가 trim
                int ex = Even((int)(cw * extra));
                int fw = Even(cw - ex * 2);
                int fx = Even(cx + ex);

                // 2) 좌우 trim 후 비율이 깨지므로 타일 비율로 높이 재조정
                var (rw, rh, rx, ry) = CropToRatio(fw, ch, fx, cy, tw, th);
                return (rw, rh, rx, ry);
            }

            // Quest 3S 먼저 판별
            if (model.Contains("3s") || model.Contains("seacliff"))
            {
                var c = CropToRatio(eyeW, eyeH, 0, 0, tileW, tileH);
                var (fw, fh, fx, fy) = ApplyExtraAndRefit(c.w, c.h, c.x, c.y, extraHCrop, tileW, tileH);
                Trace.WriteLine($"[GetQuestCropSettings] Quest 3S: crop={fw}:{fh}:{fx}:{fy} angle=22");
                return (fw, fh, fx, fy, "--angle=22");
            }

            // Quest 3 판별
            if (screenW >= 4000 || model.Contains("quest 3") || model.Contains("quest3") || model.Contains("eureka"))
            {
                var c = CropToRatio(eyeW, eyeH, 0, 0, tileW, tileH);
                var (fw, fh, fx, fy) = ApplyExtraAndRefit(c.w, c.h, c.x, c.y, extraHCrop, tileW, tileH);
                Trace.WriteLine($"[GetQuestCropSettings] Quest 3: crop={fw}:{fh}:{fx}:{fy} angle=22");
                return (fw, fh, fx, fy, "--angle=22");
            }

            // 미지 기기: angle 없음
            var cu = CropToRatio(eyeW, eyeH, 0, 0, tileW, tileH);
            Trace.WriteLine($"[GetQuestCropSettings] 알 수 없는 기기: '{model}', crop={cu.w}:{cu.h}:{cu.x}:{cu.y}");
            return (cu.w, cu.h, cu.x, cu.y, "");
        }

        public string GetLocalIPv4()
        {
            var host = Dns.GetHostEntry(Dns.GetHostName());
            foreach (var ip in host.AddressList)
            {
                if (ip.AddressFamily != AddressFamily.InterNetwork) continue;
                var s = ip.ToString();
                if (s.StartsWith("192.") || s.StartsWith("10.") || s.StartsWith("172."))
                    return s;
            }
            return null;
        }

