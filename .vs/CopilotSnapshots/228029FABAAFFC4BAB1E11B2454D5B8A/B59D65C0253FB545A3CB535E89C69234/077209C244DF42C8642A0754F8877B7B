        public async Task<Process> StartMirroringAsync(Device device, int width, int height, CancellationToken cancellationToken)
        {
            if (device == null || device.Status != "Connected") return null;

            int connectedCount = Devices.Count(d => d.IsConnected);
            // 안정성 우선: bitrate/fps 보수적으로 설정
            int bitrateMbps = connectedCount >= 5 ? 2 : 3;
            int maxFps      = 15;
            int maxSize     = connectedCount >= 5 ? 360 : 480;
            string windowTitle = device.Name ?? device.Ip;

            // 기기 모델별 좌안 영역을 타일 비율에 맞게 crop + angle 동적 결정
            // tileW/tileH를 전달해 타일 형태에 딱 맞는 비율로 crop
            var (cropW, cropH, cropX, cropY, angleArg) = await Task.Run(() => GetQuestCropSettings(device.Ip, width, height));
            string cropArg = $"--crop={cropW}:{cropH}:{cropX}:{cropY}";

            // 안정적인 display id 동적 선택 (절전/더미 display 오판정 방지)
            string displayId = await Task.Run(() => PickStableDisplayId(device.Ip));
            string displayArg = $"--display-id={displayId}";

            // 시도할 인수 세트: 1차(--video-buffer 포함), 2차(폴백 — 구버전 scrcpy 호환)
            // --window-width/height, --render-fit 제거: MoveWindow 단독으로 위치·크기 제어
            var argSets = new[]
            {
                // 1차: scrcpy v4.0 옵션 (안정성 우선: video-buffer 500으로 증가)
                new[]
                {
                    $"-s {device.Ip}",
                    displayArg,
                    cropArg,
                    angleArg,
                    "--keep-active",
                    "--stay-awake",
                    "--screen-off-timeout=1800000",
                    "--video-codec=h264",
                    "--no-audio",
                    $"--video-bit-rate={bitrateMbps}M",
                    $"--max-fps={maxFps}",
                    $"--max-size={maxSize}",
                    "--video-buffer=500",
                    $"--window-title=\"{windowTitle}\"",
                },
                // 2차 폴백: --video-buffer 제거
                new[]
                {
                    $"-s {device.Ip}",
                    displayArg,
                    cropArg,
                    angleArg,
                    "--keep-active",
                    "--stay-awake",
                    "--screen-off-timeout=1800000",
                    "--video-codec=h264",
                    "--no-audio",
                    $"--video-bit-rate={bitrateMbps}M",
                    $"--max-fps={maxFps}",
                    $"--max-size={maxSize}",
                    $"--window-title=\"{windowTitle}\"",
                },
                // 3차 폴백: 최소 옵션
                new[]
                {
                    $"-s {device.Ip}",
                    displayArg,
                    "--keep-active",
                    "--stay-awake",
                    "--no-audio",
                    $"--max-size={maxSize}",
                    $"--window-title=\"{windowTitle}\"",
                },
            };

            int pollIntervalMs = 50;
            int maxWaitMs      = 10000;  // 4000 → 10000: AnyDesk 등 원격 환경에서 창 핸들 감지 지연 대응
            string scrcpyPath  = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Scrcpy", "scrcpy.exe");
            Process newProc    = null;

            foreach (var argSet in argSets)
            {
                if (cancellationToken.IsCancellationRequested) return null;

                string arguments = string.Join(" ", argSet.Where(s => !string.IsNullOrWhiteSpace(s)));
                Trace.WriteLine($"[scrcpy] 시도: {arguments}");

                try
                {
                    var psi = new ProcessStartInfo
                    {
                        FileName               = scrcpyPath,
                        Arguments              = arguments,
                        UseShellExecute        = false,
                        CreateNoWindow         = true,
                        RedirectStandardError  = true,   // 오류 원인 캡처
                        RedirectStandardOutput = true,
                    };

                    newProc = Process.Start(psi);
                    if (newProc == null) continue;
                    newProc.EnableRaisingEvents = true;

                    // stderr를 비동기로 읽어둠 (버퍼 데드락 방지)
                    var stderrTask = newProc.StandardError.ReadToEndAsync();
                    var stdoutTask = newProc.StandardOutput.ReadToEndAsync();

                    bool hasWindow = false;
                    var sw = Stopwatch.StartNew();
                    while (sw.ElapsedMilliseconds < maxWaitMs && !cancellationToken.IsCancellationRequested)
                    {
                        if (newProc.HasExited) break;
                        try
                        {
                            newProc.Refresh();
                            if (newProc.MainWindowHandle != IntPtr.Zero) { hasWindow = true; break; }
                        }
                        catch { }
                        try { await Task.Delay(pollIntervalMs, cancellationToken); } catch { break; }
                    }

                    if (!hasWindow || newProc.HasExited)
                    {
                        // scrcpy가 즉시 종료된 경우 stderr/stdout로 원인 파악
                        string stderr = "";
                        string stdout = "";
                        try
                        {
                            if (newProc.HasExited)
                            {
                                stderr = await Task.WhenAny(stderrTask, Task.Delay(500, CancellationToken.None)) == stderrTask
                                    ? stderrTask.Result : "";
                                stdout = await Task.WhenAny(stdoutTask, Task.Delay(500, CancellationToken.None)) == stdoutTask
                                    ? stdoutTask.Result : "";
                            }
                        }
                        catch { }

                        int exitCode = -1;
                        try { if (newProc.HasExited) exitCode = newProc.ExitCode; } catch { }

                        Trace.WriteLine($"[scrcpy] 실패 (exitCode={exitCode}): {stderr?.Trim()}");

                        // 중요한 오류 메시지를 device에 기록
                        device.MirrorError = $"[exitCode={exitCode}]\n{PickImportantScrcpyError(stdout, stderr, exitCode)}";

                        try { if (!newProc.HasExited) newProc.Kill(); } catch { }
                        newProc = null;

                        bool isOptionError = !string.IsNullOrEmpty(stderr) &&
                            (stderr.Contains("unknown option", StringComparison.OrdinalIgnoreCase) ||
                             stderr.Contains("unrecognized",  StringComparison.OrdinalIgnoreCase) ||
                             stderr.Contains("invalid option",StringComparison.OrdinalIgnoreCase) ||
                             stderr.Contains("--video-buffer",StringComparison.OrdinalIgnoreCase));

                        if (!isOptionError)
                        {
                            try { await Task.Delay(400, cancellationToken); } catch { return null; }
                        }
                        continue;
                    }

                    // 성공 — 오류 메시지 클리어
                    device.MirrorError = null;
                    Trace.WriteLine($"[scrcpy] 시작 성공 (pid={newProc.Id})");
                    return newProc;
                }
                catch (OperationCanceledException)
                {
                    if (newProc != null && !newProc.HasExited) try { newProc.Kill(); } catch { }
                    throw;
                }
                catch (Exception ex)
                {
                    Trace.WriteLine($"[scrcpy] 예외: {ex.Message}");
                    device.MirrorError = $"실행 오류: {ex.Message}";
                    if (newProc != null && !newProc.HasExited) try { newProc.Kill(); } catch { }
                    newProc = null;
                    try { await Task.Delay(300, cancellationToken); } catch { return null; }
                }
            }

            if (cancellationToken.IsCancellationRequested && newProc != null && !newProc.HasExited)
            {
                try { newProc.Kill(); } catch { }
                return null;
            }

            return newProc; // null (모든 시도 실패)
        }

        public async Task<Process> StartMirroringWithSemaphoreAsync(Device device, int width, int height, CancellationToken cancellationToken)
        {
            await _scrcpySemaphore.WaitAsync(cancellationToken);
            try
            {
                // StartMirroringAsync 내부에서 이미 maxRetry=3 재시도를 수행하므로 여기서 추가 재시도 불필요
                // 중복 재시도 시 세마포어를 최대 9회×4초 = 36초 점유 → 다른 기기 대기 급증
                return await StartMirroringAsync(device, width, height, cancellationToken);
            }
            finally
            {
                _scrcpySemaphore.Release();
            }
        }

