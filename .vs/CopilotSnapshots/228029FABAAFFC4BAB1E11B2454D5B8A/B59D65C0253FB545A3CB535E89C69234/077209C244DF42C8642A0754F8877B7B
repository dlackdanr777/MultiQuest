        /// <summary>
        /// RTSP 하드 재시작 쿨다운 체크 (과도한 재시작 방지)
        /// </summary>
        private bool CanHardRestartRtsp(string key, int cooldownMs = 5000)
        {
            lock (_rtspHealthLock)
            {
                if (_lastRtspHardRestartUtc.TryGetValue(key, out var last))
                {
                    if ((DateTime.UtcNow - last).TotalMilliseconds < cooldownMs)
                        return false;
                }

                _lastRtspHardRestartUtc[key] = DateTime.UtcNow;
                return true;
            }
        }

        /// <summary>
        /// RTSP 타일을 완전히 재생성하여 죽은 MediaPlayer 연결 복구
        /// (공유 재시작 시 URL은 같지만 세션이 끊긴 경우)
        /// </summary>
        private void HardRestartRtspTile(Device device, string reason)
        {
            if (device == null)
                return;

            if (string.IsNullOrWhiteSpace(device.RtspUrl))
                return;

            string host = !string.IsNullOrWhiteSpace(device.AgentHost)
                ? device.AgentHost
                : GetHostOnly(device.Ip);

            if (string.IsNullOrWhiteSpace(host))
                return;

            var oldAgent = device.Rtsp?.Agent;
            var agent = oldAgent ?? new QuestAgentInfo();

            agent.Host = host;
            agent.Ip = host;
            agent.StatusPort = device.AgentStatusPort > 0 ? device.AgentStatusPort : 18080;
            agent.RtspUrl = device.RtspUrl;
            agent.RtspPort = 8554;
            agent.Model = device.Name;
            agent.StreamState = "streaming";
            agent.Battery = device.BatteryLevel;

            Debug.WriteLine($"[RTSP] HardRestart: {device.Name}, reason={reason}, url={device.RtspUrl}");

            try
            {
                device.Rtsp?.Stop();
            }
            catch { }

            try
            {
                device.Rtsp?.Dispose();
            }
            catch { }

            device.Rtsp = new RtspTileViewModel(
                _rtspLibVlc,
                agent,
                _rtspQualityManager);

            int activeStreams = Math.Max(1, Devices.Count(d => d.Rtsp != null));

            device.Rtsp.Start(activeStreams);
        }

        /// <summary>
        /// RTSP 포트가 다운→업으로 복구되었는지 체크하여 자동 하드 재시작
        /// </summary>
        private async Task CheckRtspRecoveryAsync(
            string ip,
            string rtspUrl,
            string streamState)
        {
            if (string.IsNullOrWhiteSpace(rtspUrl))
                return;

            if (!TryGetRtspEndpoint(rtspUrl, out var rtspHost, out var rtspPort))
                return;

            string key = $"{rtspHost}:{rtspPort}";

            bool portOpen = await IsTcpOpenAsync(rtspHost, rtspPort, 800);

            bool isStreamingOrStarting =
                string.Equals(streamState, "RUNNING", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(streamState, "STARTING", StringComparison.OrdinalIgnoreCase);

            if (!portOpen || !isStreamingOrStarting)
            {
                lock (_rtspHealthLock)
                {
                    _rtspWasDown.Add(key);
                }

                return;
            }

            bool shouldRestart = false;

            lock (_rtspHealthLock)
            {
                if (_rtspWasDown.Contains(key))
                {
                    _rtspWasDown.Remove(key);
                    shouldRestart = true;
                }
            }

            if (!shouldRestart)
                return;

            if (!CanHardRestartRtsp(key))
                return;

            await Dispatcher.InvokeAsync(() =>
            {
                var device = Devices.FirstOrDefault(d =>
                    string.Equals(d.Ip, ip, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(d.AgentHost, rtspHost, StringComparison.OrdinalIgnoreCase));

                if (device != null)
                {
                    HardRestartRtspTile(device, "RTSP recovered after sleep/share restart");
                }
            });
        }

        private async Task<List<string>> FindAliveIpsAsync(string baseIp, string localIp, int ipStart, int ipEnd, ProgressWindow progress, CancellationToken token)
        {
            var aliveIps = new ConcurrentBag<string>();
            var allIps = Enumerable.Range(ipStart, ipEnd - ipStart + 1).Select(i => baseIp + i).ToList();
            int totalIp = allIps.Count;
            int done = 0;

            try
            {
                await Task.Run(() =>
                {
                    try
                    {
                        Parallel.ForEach(allIps, new ParallelOptions { MaxDegreeOfParallelism = 128, CancellationToken = token }, ip =>
                        {
                            if (token.IsCancellationRequested) return;
                            try
                            {
                                using var ping = new Ping();
                                var reply = ping.Send(ip, 200); // 300→200ms 단축
                                if (reply.Status == IPStatus.Success && ip != localIp)
                                    aliveIps.Add(ip);
                            }
                            catch { }

                            int d = Interlocked.Increment(ref done);
                            if (!token.IsCancellationRequested && (d % 20 == 0 || d == totalIp))
                                Dispatcher.BeginInvoke(() => progress.SetProgress(d, totalIp));
                        });
                    }
                    catch (OperationCanceledException) { }
                });
            }
            catch (OperationCanceledException) { }
            return aliveIps.ToList();
        }

        public async Task<List<(string ip, int port)>> ScanPortsAsync(
            List<string> ips, int portStart, int portEnd, IProgress<int> progress = null, CancellationToken token = default)
        {
            var openPorts = new ConcurrentBag<(string, int)>();
            int maxParallel = 400;
            var throttler = new SemaphoreSlim(maxParallel);
            var tasks = new List<Task>();
            int completed = 0, totalPort = ips.Count * (portEnd - portStart + 1);
            int reportInterval = Math.Max(totalPort / 100, 1);

            try
            {
                // 가능성 높은 5555 선탐색
                foreach (var ip in ips)
                {
                    if (token.IsCancellationRequested) break;
                    await throttler.WaitAsync(token);
                    tasks.Add(Task.Run(async () =>
                    {
                        try
                        {
                            if (await TryConnectPort(ip, 5555, token))
                                openPorts.Add((ip, 5555));
                        }
                        catch { }
                        finally
                        {
                            int done = Interlocked.Increment(ref completed);
                            if (done % reportInterval == 0 || done == totalPort)
                                progress?.Report(done);
                            throttler.Release();
                        }
                    }, token));
                }

                // 범위 스캔
                foreach (var ip in ips)
                {
                    for (int port = portStart; port <= portEnd; port++)
                    {
                        if (port == 5555) continue;
                        if (token.IsCancellationRequested) break;
                        await throttler.WaitAsync(token);
                        var t = ScanPortAsync(ip, port, openPorts, throttler, () =>
                        {
                            int done = Interlocked.Increment(ref completed);
                            if (done % reportInterval == 0 || done == totalPort)
                                progress?.Report(done);
                        }, token);
                        tasks.Add(t);
                    }
                }
                await Task.WhenAll(tasks);
            }
            catch (OperationCanceledException) { }
            return openPorts.ToList();
        }

        private async Task ScanPortAsync(string ip, int port, ConcurrentBag<(string, int)> openPorts, SemaphoreSlim throttler, Action onComplete, CancellationToken token)
        {
            try
            {
                if (token.IsCancellationRequested) return;
                if (await TryConnectPort(ip, port, token))
                    openPorts.Add((ip, port));
            }
            catch { }
            finally
            {
                onComplete?.Invoke();
                throttler.Release();
            }
        }

        private static async Task<bool> TryConnectPort(string ip, int port, CancellationToken token)
        {
            try
            {
                using var client = new TcpClient();
                var connectTask = client.ConnectAsync(ip, port);
                var timeoutTask = Task.Delay(200, token); // 150→200ms: 포트 탄지 실패륙 감소
                var completedTask = await Task.WhenAny(connectTask, timeoutTask);
                return completedTask == connectTask && client.Connected;
            }
            catch { return false; }
        }

