        private async void AgentSearchButton_Click(object sender, RoutedEventArgs e)
        {
            PlayClickSound();

            ShowSearchOverlay("MultiQuest Agent 검색 중...");

            try
            {
                var agents = await AgentMdnsDiscovery.DiscoverAsync(
                    mdnsTimeoutMs: 3000,
                    directScanTimeoutMs: 2500);

                if (agents.Count == 0)
                {
                    HideSearchOverlay();

                    MessageBox.Show(
                        "MultiQuest Agent를 찾지 못했습니다.\n\n" +
                        "확인 순서:\n" +
                        "1. Quest와 PC가 같은 공유기/LAN인지 확인\n" +
                        "2. PC에서 curl http://QuestIP:18080/status 테스트\n" +
                        "3. 공유기 AP Isolation / Client Isolation 꺼져 있는지 확인\n" +
                        "4. Android 로그에서 MQ-HTTP: HTTP server started on port=18080 확인",
                        "Agent 검색 실패",
                        MessageBoxButton.OK,
                        MessageBoxImage.Warning);
                    return;
                }

                var rtspAgents = new List<QuestAgentInfo>();
                var warnings = new List<string>();

                foreach (var agent in agents)
                {
                    if (string.IsNullOrWhiteSpace(agent.RtspUrl))
                        continue;

                    if (!TryGetRtspEndpoint(agent.RtspUrl, out var rtspHost, out var rtspPort))
                    {
                        warnings.Add($"{agent.Model} - RTSP URL 파싱 실패: {agent.RtspUrl}");
                        continue;
                    }

                    bool isStreamingOrStarting =
                        string.Equals(agent.StreamState, "RUNNING", StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(agent.StreamState, "STARTING", StringComparison.OrdinalIgnoreCase);

                    bool rtspPortOpen = await IsTcpOpenAsync(rtspHost, rtspPort, 1200);

                    // 핵심 변경:
                    // stopped여도 RTSP URL이 있으면 일단 타일에 넣고 재생 시도
                    rtspAgents.Add(agent);

                    // RUNNING이나 STARTING 상태일 때는 경고 표시 안 함 (정상 동작 상태)
                    if (!isStreamingOrStarting && !rtspPortOpen)
                    {
                        warnings.Add(
                            $"{agent.Model} / {rtspHost}:{rtspPort}\n" +
                            $"streamState={agent.StreamState}, portOpen={rtspPortOpen}");
                    }
                }

                if (rtspAgents.Count == 0)
                {
                    HideSearchOverlay();

                    MessageBox.Show(
                        "Agent는 찾았지만 RTSP URL이 있는 기기가 없습니다.\n\n" +
                        string.Join("\n\n", agents.Select(a => a.ToString())),
                        $"MultiQuest Agent 발견: {agents.Count}개",
                        MessageBoxButton.OK,
                        MessageBoxImage.Warning);
                    return;
                }

                ApplyRtspAgentsToDeviceTiles(rtspAgents);

                PanelMetaDevice.Visibility   = Visibility.Visible;
                PanelXrExperience.Visibility = Visibility.Collapsed;
                PanelXrCoding.Visibility     = Visibility.Collapsed;
                PanelXrEnglish.Visibility    = Visibility.Collapsed;
                SetSideButtonActive(BtnMetaDevice);

                // Agent 검색 후 즉시 상태 업데이트
                UpdateStatus(null, null);

                HideSearchOverlay();

                if (warnings.Count > 0)
                {
                    MessageBox.Show(
                        "RTSP URL이 있어 재생을 시도합니다.\n" +
                        "다만 Agent 상태와 실제 RTSP 포트 상태가 불일치합니다.\n\n" +
                        string.Join("\n\n", warnings),
                        "RTSP 상태 경고",
                        MessageBoxButton.OK,
                        MessageBoxImage.Information);
                }
                else
                {
                    MessageBox.Show(
                        $"RTSP 미러링 타일 적용 완료: {rtspAgents.Count}개",
                        "RTSP 미러링",
                        MessageBoxButton.OK,
                        MessageBoxImage.Information);
                }
            }
            catch (Exception ex)
            {
                HideSearchOverlay();

                MessageBox.Show(
                    $"Agent 검색 중 오류가 발생했습니다:\n{ex.Message}",
                    "오류",
                    MessageBoxButton.OK,
                    MessageBoxImage.Error);
            }
        }

        private static bool TryGetRtspEndpoint(string rtspUrl, out string host, out int port)
        {
            host = null;
            port = 0;

            try
            {
                if (!Uri.TryCreate(rtspUrl, UriKind.Absolute, out var uri))
                    return false;

                if (!string.Equals(uri.Scheme, "rtsp", StringComparison.OrdinalIgnoreCase))
                    return false;

                host = uri.Host;
                port = uri.Port > 0 ? uri.Port : 8554;

                return !string.IsNullOrWhiteSpace(host) && port > 0;
            }
            catch
            {
                return false;
            }
        }

        private static async Task<bool> IsTcpOpenAsync(string host, int port, int timeoutMs = 1200)
        {
            try
            {
                using var client = new System.Net.Sockets.TcpClient();

                var connectTask = client.ConnectAsync(host, port);
                var timeoutTask = Task.Delay(timeoutMs);

                var completed = await Task.WhenAny(connectTask, timeoutTask);

                if (completed != connectTask)
                    return false;

                return client.Connected;
            }
            catch
            {
                return false;
            }
        }

        private void ApplyRtspAgentsToDeviceTiles(IReadOnlyList<QuestAgentInfo> agents)
        {
            if (agents == null || agents.Count == 0)
                return;

            StopAllScrcpyMirrors();

            var activeAgentHosts = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            int activeStreamCount = 0;

            foreach (var agent in agents)
            {
                string host = NormalizeAgentHost(agent);
                if (string.IsNullOrWhiteSpace(host))
                    continue;

                activeAgentHosts.Add(host);

                var device = FindDeviceByAgentHost(host);

                if (device == null)
                {
                    device = new Device
                    {
                        Serial = !string.IsNullOrWhiteSpace(agent.DeviceId) ? agent.DeviceId : host,
                        Ip = host,
                        Status = "AgentOnly",
                        Name = !string.IsNullOrWhiteSpace(agent.Model) ? agent.Model : host
                    };

                    Devices.Add(device);
                }

                device.AgentHost = host;
                device.AgentStatusPort = agent.StatusPort;
                device.RtspUrl = agent.RtspUrl;
                device.BatteryLevel = agent.Battery >= 0 ? agent.Battery : device.BatteryLevel;
                device.IsCharging = agent.IsCharging;
                device.ChargingStatus = agent.ChargingStatus;

                // 시리얼이 없으면 Agent에서 가져오기
                if (string.IsNullOrEmpty(device.Serial) && !string.IsNullOrEmpty(agent.Serial))
                {
                    device.Serial = agent.Serial;
                }

                // 이름 설정 우선순위 (빈 문자열과 공백 체크 강화):
                // 1. Agent가 보낸 고유 식별 이름 (deviceName) - 비어있지 않고 공백이 아닐 때만
                // 2. Settings에서 시리얼로 매핑한 이름
                // 3. Agent의 Model 정보 (Quest 3, Quest 3S 등)
                // 4. Serial 또는 Host
                if (!string.IsNullOrWhiteSpace(agent.DeviceName))
                {
                    device.Name = agent.DeviceName.Trim();
                    Debug.WriteLine($"[ApplyAgents] Device {host} name from Agent: '{device.Name}'");
                }
                else if (!string.IsNullOrEmpty(device.Serial) && 
                    _serialNameDic.TryGetValue(device.Serial, out var customName) &&
                    !string.IsNullOrWhiteSpace(customName))
                {
                    device.Name = customName.Trim();
                    Debug.WriteLine($"[ApplyAgents] Device {host} name from Settings: '{device.Name}'");
                }
                else if (!string.IsNullOrWhiteSpace(agent.Model) &&
                         (string.IsNullOrWhiteSpace(device.Name) || device.Name == device.Serial || device.Name == host))
                {
                    device.Name = agent.Model.Trim();
                    Debug.WriteLine($"[ApplyAgents] Device {host} name from Model: '{device.Name}'");
                }
                else if (string.IsNullOrWhiteSpace(device.Name))
                {
                    device.Name = !string.IsNullOrEmpty(device.Serial) ? device.Serial : host;
                    Debug.WriteLine($"[ApplyAgents] Device {host} name fallback: '{device.Name}'");
                }

                bool needNewTile =
                    device.Rtsp == null ||
                    !string.Equals(device.Rtsp.Agent.RtspUrl, agent.RtspUrl, StringComparison.OrdinalIgnoreCase);

                if (needNewTile)
                {
                    try { device.Rtsp?.Dispose(); } catch { }

                    device.Rtsp = new RtspTileViewModel(_rtspLibVlc, agent, _rtspQualityManager);
                }

                activeStreamCount++;
            }

            // 모든 스트림 시작 (동시 스트림 수 전달)
            foreach (var agent in agents)
            {
                string host = NormalizeAgentHost(agent);
                var device = FindDeviceByAgentHost(host);
                if (device?.Rtsp != null)
                {
                    device.Rtsp.Start(activeStreamCount);
                }
            }

            foreach (var device in Devices.ToList())
            {
                if (string.IsNullOrWhiteSpace(device.AgentHost))
                    continue;

                if (!activeAgentHosts.Contains(device.AgentHost))
                {
                    try { device.Rtsp?.Stop(); } catch { }
                }
            }

            foreach (var device in Devices.ToList())
            {
                if (string.IsNullOrWhiteSpace(device.AgentHost))
                    continue;

                if (!activeAgentHosts.Contains(device.AgentHost))
                {
                    try { device.Rtsp?.Stop(); } catch { }
                }
            }
        }

        private Device FindDeviceByAgentHost(string host)
        {
            if (string.IsNullOrWhiteSpace(host))
                return null;

            return Devices.FirstOrDefault(d =>
                string.Equals(GetHostOnly(d.Ip), host, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(d.AgentHost, host, StringComparison.OrdinalIgnoreCase));
        }

        private static string NormalizeAgentHost(QuestAgentInfo agent)
        {
            if (agent == null)
                return null;

            if (!string.IsNullOrWhiteSpace(agent.Host))
                return agent.Host.Trim();

            if (!string.IsNullOrWhiteSpace(agent.Ip))
                return agent.Ip.Trim();

            return null;
        }

        private static string GetHostOnly(string value)
        {
            if (string.IsNullOrWhiteSpace(value))
                return value;

            var s = value.Trim();

            int idx = s.LastIndexOf(':');
            if (idx > 0 && idx < s.Length - 1)
            {
                string host = s.Substring(0, idx);
                if (IPAddress.TryParse(host, out _))
                    return host;
            }

            return s;
        }

        private void StopAllScrcpyMirrors()
        {
            Process[] snapshot;

            lock (_mirrorLock)
            {
                snapshot = _scrcpy.Values.ToArray();
                _scrcpy.Clear();
                _mirrorStarting.Clear();

                foreach (var kv in _mirrorRestartTokens.ToList())
                {
                    try { kv.Value.Cancel(); } catch { }
                    try { kv.Value.Dispose(); } catch { }
                }

                _mirrorRestartTokens.Clear();
                _scrcpyRestartAttempts.Clear();
            }

            foreach (var proc in snapshot)
            {
                try
                {
                    if (proc.MainWindowHandle != IntPtr.Zero)
                        ScrcpyEmbedder.HideWindow(proc.MainWindowHandle);
                }
                catch { }

                try
                {
                    if (!proc.HasExited)
                        proc.Kill();
                }
                catch { }

                try { proc.Dispose(); } catch { }
            }
        }

        // mDNS 이후 보강: 기존 Connected 유지, 신규만 추가
        private async Task<int> IpAugmentScanAsync(ProgressWindow progress, CancellationToken token)
        {
            string localIp = GetLocalIPv4();
            if (string.IsNullOrEmpty(localIp))
            {
                Dispatcher.Invoke(() => ShowMsg("로컈 IP를 감지할 수 없습니다."));
                return 0;
            }

            string[] ipParts = localIp.Split('.');
            string baseIp = $"{ipParts[0]}.{ipParts[1]}.{ipParts[2]}.";

            int ipStart = 2, ipEnd = 254;
            // 메타퀴스트 ADB 포트 범위: 37000전후 + 5555 + 6555
            // 전체 포트를 스캔하는 대신 집중 범위 사용으로 속도 향상
            int portStart = 30000, portEnd = 49999;

            // 이미 연결/추가된 IP:PORT는 제외
            var existingAddrs = new HashSet<string>(Devices.Select(d => d.Ip), StringComparer.OrdinalIgnoreCase);
            var existingIps = new HashSet<string>(existingAddrs.Select(a => a.Split(':')[0]), StringComparer.OrdinalIgnoreCase);

            // 1) alive IP 수집
            List<string> aliveIps = null;
            try { aliveIps = await FindAliveIpsAsync(baseIp, localIp, ipStart, ipEnd, progress, token); }
            catch (OperationCanceledException) { return 0; }

            // alive 0이면 /24 전체 저강도 스캔 (샘스위대뱄)
            if (aliveIps.Count == 0)
            {
                aliveIps = Enumerable.Range(ipStart, ipEnd - ipStart + 1)
                    .Select(i => baseIp + i)
                    .Where(ip => ip != localIp)
                    .ToList();
            }

            // 이미 알고 있는 IP는 제외 (중복 스캔 억제)
            aliveIps = aliveIps.Where(ip => !existingIps.Contains(ip)).ToList();
            if (aliveIps.Count == 0) return 0;

            int totalPort = aliveIps.Count * (portEnd - portStart + 1);

            // 2) 포트 스캔
            List<(string ip, int port)> openPorts = null;
            try
            {
                Debug.WriteLine($"대상 IP 개수: {aliveIps.Count}, 포트 범위: {portStart}-{portEnd}");
                openPorts = await ScanPortsAsync(
                    aliveIps, portStart, portEnd,
                    new Progress<int>(v => progress.SetProgress(v, totalPort)), token);
            }
            catch (OperationCanceledException) { return 0; }

            if (token.IsCancellationRequested) return 0;

            // 3) HTTP Agent 연결 확인 (ADB 연결 제거됨)
            int foundCount = 0;
            try
            {
                var tasks = openPorts.Select(async target =>
                {
                    if (token.IsCancellationRequested) return;

                    string addr = $"{target.ip}:{target.port}";
                    if (existingAddrs.Contains(addr)) return;

                    try
                    {
                        var status = await AgentApi.GetStatusAsync(target.ip, target.port);
                        if (status != null && !string.IsNullOrEmpty(status.SerialNumber))
                        {
                            Dispatcher.Invoke(() =>
                            {
                                if (!Devices.Any(d => d.Ip == addr))
                                {
                                    AddDevice(new Device 
                                    { 
                                        Serial = status.SerialNumber, 
                                        Ip = addr, 
                                        Status = "Connected",
                                        AgentHost = target.ip,
                                        AgentPort = target.port
                                    });
                                    Interlocked.Increment(ref foundCount);
                                }
                            });
                        }
                    }
                    catch { }
                });
                await Task.WhenAll(tasks);
            }
            catch (OperationCanceledException) { return foundCount; }

            return foundCount;
        }

