        private void StopMirrorForDevice(Device device)
        {
            if (device == null || string.IsNullOrWhiteSpace(device.Ip)) return;

            string mirrorKey = device.Ip;

            // 1. 예약된 자동 재시작 취소
            CancelPendingMirrorRestart(mirrorKey);

            // 2. 프로세스 종료 및 제거
            lock (_mirrorLock)
            {
                if (_scrcpy.TryGetValue(mirrorKey, out var p))
                {
                    try
                    {
                        var hwnd = p.MainWindowHandle;

                        if (hwnd != IntPtr.Zero)
                            ScrcpyEmbedder.HideWindow(hwnd);

                        _scrcpy.Remove(mirrorKey);

                        if (!p.HasExited)
                            p.Kill();
                    }
                    catch { }
                }

                _mirrorStarting.Remove(mirrorKey);
            }
        }

