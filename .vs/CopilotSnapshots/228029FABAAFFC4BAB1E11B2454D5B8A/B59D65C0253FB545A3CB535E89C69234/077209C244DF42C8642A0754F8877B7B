        public async void StopDeviceApp(Device device, Action onCompleted = null)
        {
            if (device == null)
            {
                ShowMsg("기기를 확인하세요.");
                onCompleted?.Invoke();
                return;
            }

            if (string.IsNullOrWhiteSpace(device.AgentHost))
            {
                ShowMsg("이 기기는 Agent로 연결되어 있지 않습니다. Agent 검색을 먼저 실행하세요.");
                onCompleted?.Invoke();
                return;
            }

            var pkgs = GetAllUniquePkgs();

            var (anyStopOk, homeOk, failedPackages) = await StopPackagesByAgentAsync(
                device,
                pkgs,
                goHomeAfterStop: true);

            if (!anyStopOk && !homeOk)
            {
                ShowMsg("앱 종료에 실패했습니다. Agent 상태와 StoryWing 앱의 종료 수신기 적용 여부를 확인하세요.");
            }
            else if (!anyStopOk && homeOk)
            {
                ShowMsg(
                    "홈 이동은 성공했지만 앱의 협력 종료 응답은 확인되지 않았습니다.\n" +
                    "각 StoryWing 앱에 MultiQuestCommandReceiver가 적용되어 있는지 확인하세요.");
            }

            onCompleted?.Invoke();
        }

