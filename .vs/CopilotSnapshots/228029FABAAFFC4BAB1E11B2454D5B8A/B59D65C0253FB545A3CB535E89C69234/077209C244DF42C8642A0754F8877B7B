    // ====================== Agent mDNS Discovery ======================
    public static class AgentMdnsDiscovery
    {
        private const string Service = "_multiquest-agent._tcp.local.";
        private const int FixedStatusPort = 18080;

        public static async Task<List<QuestAgentInfo>> DiscoverAsync(
            int mdnsTimeoutMs = 3000,
            int directScanTimeoutMs = 2500,
            CancellationToken cancellationToken = default)
        {
            var found = new Dictionary<string, QuestAgentInfo>(StringComparer.OrdinalIgnoreCase);

            // 1. mDNS 검색
            var mdnsAgents = await DiscoverByMdnsAsync(mdnsTimeoutMs, cancellationToken);
            foreach (var agent in mdnsAgents)
            {
                AddUnique(found, agent);
            }

            // 2. 18080 직접 스캔 fallback
            // mDNS가 성공했더라도 추가 Agent가 mDNS에 안 잡힐 수 있으므로 fallback도 같이 실행
            var directAgents = await DiscoverByDirectScanAsync(directScanTimeoutMs, cancellationToken);
            foreach (var agent in directAgents)
            {
                AddUnique(found, agent);
            }

            return found.Values
                .OrderBy(x => x.Model)
                .ThenBy(x => x.Host)
                .ToList();
        }

        private static async Task<List<QuestAgentInfo>> DiscoverByMdnsAsync(
            int timeoutMs,
            CancellationToken cancellationToken)
        {
            var list = new List<QuestAgentInfo>();

            IReadOnlyList<IZeroconfHost> responses;

            try
            {
                responses = await ZeroconfResolver.ResolveAsync(
                    Service,
                    scanTime: TimeSpan.FromMilliseconds(timeoutMs));
            }
            catch
            {
                return list;
            }

            using var http = new HttpClient
            {
                Timeout = TimeSpan.FromMilliseconds(1500)
            };

            foreach (var resp in responses)
            {
                cancellationToken.ThrowIfCancellationRequested();

                var rec = resp.Services.Values.FirstOrDefault(x => x.Port > 0);
                if (rec == null)
                    continue;

                var host = resp.IPAddresses?.FirstOrDefault(ip =>
                    IPAddress.TryParse(ip, out var parsed) &&
                    parsed.AddressFamily == AddressFamily.InterNetwork);

                if (string.IsNullOrWhiteSpace(host))
                    continue;

                var agent = await ProbeAgentAsync(
                    http,
                    host,
                    rec.Port,
                    "mDNS",
                    cancellationToken);

                if (agent != null)
                    list.Add(agent);
            }

            return list;
        }

        private static async Task<List<QuestAgentInfo>> DiscoverByDirectScanAsync(
            int timeoutMs,
            CancellationToken cancellationToken)
        {
            var results = new ConcurrentBag<QuestAgentInfo>();
            var targets = GetCandidateIps();

            if (targets.Count == 0)
                return new List<QuestAgentInfo>();

            using var http = new HttpClient
            {
                Timeout = TimeSpan.FromMilliseconds(Math.Max(500, timeoutMs))
            };

            using var throttler = new SemaphoreSlim(64);

            var tasks = targets.Select(async ip =>
            {
                if (cancellationToken.IsCancellationRequested)
                    return;

                await throttler.WaitAsync(cancellationToken);

                try
                {
                    var agent = await ProbeAgentAsync(
                        http,
                        ip,
                        FixedStatusPort,
                        "DirectScan:18080",
                        cancellationToken);

                    if (agent != null)
                        results.Add(agent);
                }
                catch
                {
                    // 개별 IP 실패는 무시
                }
                finally
                {
                    throttler.Release();
                }
            }).ToList();

            try
            {
                await Task.WhenAll(tasks);
            }
            catch
            {
                // 전체 스캔 중 일부 실패는 무시
            }

            return results.ToList();
        }

        private static async Task<QuestAgentInfo> ProbeAgentAsync(
            HttpClient http,
            string host,
            int port,
            string source,
            CancellationToken cancellationToken)
        {
            try
            {
                string url = $"http://{host}:{port}/status";
                string json = await http.GetStringAsync(url, cancellationToken);

                var info = JsonSerializer.Deserialize<QuestAgentInfo>(
                    json,
                    new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                if (info == null)
                    return null;

                // Agent status JSON이 아닌 다른 HTTP 서버가 잡힌 경우 방지
                bool looksLikeAgent =
                    !string.IsNullOrWhiteSpace(info.DeviceId) ||
                    !string.IsNullOrWhiteSpace(info.RtspUrl) ||
                    !string.IsNullOrWhiteSpace(info.AgentVersion);

                if (!looksLikeAgent)
                    return null;

                info.Host = host;
                info.StatusPort = port;
                info.DiscoverySource = source;

                if (string.IsNullOrWhiteSpace(info.Ip) || info.Ip == "0.0.0.0")
                    info.Ip = host;

                return info;
            }
            catch
            {
                return null;
            }
        }

        private static void AddUnique(
            Dictionary<string, QuestAgentInfo> found,
            QuestAgentInfo agent)
        {
            if (agent == null)
                return;

            string key = !string.IsNullOrWhiteSpace(agent.DeviceId)
                ? agent.DeviceId
                : $"{agent.Host}:{agent.StatusPort}";

            // mDNS와 DirectScan이 둘 다 잡히면 mDNS 우선
            if (found.TryGetValue(key, out var existing))
            {
                if (existing.DiscoverySource?.StartsWith("DirectScan", StringComparison.OrdinalIgnoreCase) == true &&
                    agent.DiscoverySource?.Equals("mDNS", StringComparison.OrdinalIgnoreCase) == true)
                {
                    found[key] = agent;
                }

                return;
            }

            found[key] = agent;
        }

        private static List<string> GetCandidateIps()
        {
            var ips = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var localIp in GetLocalPrivateIPv4Addresses())
            {
                var parts = localIp.Split('.');
                if (parts.Length != 4)
                    continue;

                string prefix = $"{parts[0]}.{parts[1]}.{parts[2]}.";

                for (int i = 2; i <= 254; i++)
                {
                    string candidate = prefix + i;

                    if (!candidate.Equals(localIp, StringComparison.OrdinalIgnoreCase))
                        ips.Add(candidate);
                }
            }

            return ips.ToList();
        }

        private static List<string> GetLocalPrivateIPv4Addresses()
        {
            var result = new List<string>();

            try
            {
                foreach (var ni in NetworkInterface.GetAllNetworkInterfaces())
                {
                    if (ni.OperationalStatus != OperationalStatus.Up)
                        continue;

                    if (ni.NetworkInterfaceType == NetworkInterfaceType.Loopback)
                        continue;

                    var props = ni.GetIPProperties();

                    // 게이트웨이가 없는 가상 어댑터/VPN은 우선 제외
                    bool hasGateway = props.GatewayAddresses.Any(g =>
                        g.Address.AddressFamily == AddressFamily.InterNetwork &&
                        !IPAddress.IsLoopback(g.Address));

                    if (!hasGateway)
                        continue;

                    foreach (var ua in props.UnicastAddresses)
                    {
                        if (ua.Address.AddressFamily != AddressFamily.InterNetwork)
                            continue;

                        if (!IsPrivateIPv4(ua.Address))
                            continue;

                        result.Add(ua.Address.ToString());
                    }
                }
            }
            catch
            {
            }

            return result.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        }

        private static bool IsPrivateIPv4(IPAddress ip)
        {
            var b = ip.GetAddressBytes();

            // 10.0.0.0/8
            if (b[0] == 10)
                return true;

            // 172.16.0.0/12
            if (b[0] == 172 && b[1] >= 16 && b[1] <= 31)
                return true;

            // 192.168.0.0/16
            if (b[0] == 192 && b[1] == 168)
                return true;

            return false;
        }
    }

    // ====================== Device ======================
    public class Device : INotifyPropertyChanged
    {
        private string _name;
        private string _serial;
        private string _ip;
        private string _status;
        private int _batteryLevel = -1;
        private bool _systemUIActive;
        private RtspTileViewModel _rtsp;
        private string _agentHost;
        private int _agentStatusPort;
        private string _rtspUrl;
        private bool _isCharging;
        private string _chargingStatus;
        private string _streamState;

        public string Name
        {
            get => _name;
            set { if (_name != value) { _name = value; OnPropertyChanged(); } }
        }

        public string Serial
        {
            get => _serial;
            set { if (_serial != value) { _serial = value; OnPropertyChanged(); } }
        }

        public string Ip
        {
            get => _ip;
            set { if (_ip != value) { _ip = value; OnPropertyChanged(); } }
        }

        public string Status
        {
            get => _status;
            set { if (_status != value) { _status = value; OnPropertyChanged(); OnPropertyChanged(nameof(IsConnected)); OnPropertyChanged(nameof(IsAgentOnly)); } }
        }

        public int BatteryLevel
        {
            get => _batteryLevel;
            set { if (_batteryLevel != value) { _batteryLevel = value; OnPropertyChanged(); OnPropertyChanged(nameof(BatteryText)); } }
        }

        public bool IsCharging
        {
            get => _isCharging;
            set { if (_isCharging != value) { _isCharging = value; OnPropertyChanged(); OnPropertyChanged(nameof(BatteryText)); } }
        }

        public string ChargingStatus
        {
            get => _chargingStatus;
            set { if (_chargingStatus != value) { _chargingStatus = value; OnPropertyChanged(); } }
        }

        private string _mirrorError;
        public string MirrorError
        {
            get => _mirrorError;
            set { if (_mirrorError != value) { _mirrorError = value; OnPropertyChanged(); OnPropertyChanged(nameof(HasMirrorError)); } }
        }
        public bool HasMirrorError => !string.IsNullOrEmpty(_mirrorError);

        /// <summary>
        /// Quest에서 Boundary/설정/시스템 UI가 활성화되어 있는지 여부.
        /// true일 때는 scrcpy 검은 화면이 정상이므로 재시작하지 않는다.
        /// </summary>
        public bool SystemUIActive
        {
            get => _systemUIActive;
            set { if (_systemUIActive != value) { _systemUIActive = value; OnPropertyChanged(); OnPropertyChanged(nameof(SystemUIMessage)); } }
        }

        public string SystemUIMessage => SystemUIActive 
            ? "⚠️ 시스템 UI 표시 중\nQuest에서 Boundary/설정 화면을 확인해 주세요" 
            : null;

        public RtspTileViewModel Rtsp
        {
            get => _rtsp;
            set
            {
                if (_rtsp != value)
                {
                    _rtsp = value;
                    OnPropertyChanged();
                    OnPropertyChanged(nameof(HasRtsp));
                }
            }
        }

        public bool HasRtsp => Rtsp != null;

        public string AgentHost
        {
            get => _agentHost;
            set
            {
                if (_agentHost != value)
                {
                    _agentHost = value;
                    OnPropertyChanged();
                }
            }
        }

        public int AgentStatusPort
        {
            get => _agentStatusPort;
            set
            {
                if (_agentStatusPort != value)
                {
                    _agentStatusPort = value;
                    OnPropertyChanged();
                }
            }
        }

        public string RtspUrl
        {
            get => _rtspUrl;
            set
            {
                if (_rtspUrl != value)
                {
                    _rtspUrl = value;
                    OnPropertyChanged();
                }
            }
        }

        public string StreamState
        {
            get => _streamState;
            set
            {
                if (_streamState != value)
                {
                    _streamState = value;
                    OnPropertyChanged();
                    OnPropertyChanged(nameof(StreamStateText));
                    OnPropertyChanged(nameof(StreamStateColor));
                }
            }
        }

        public string StreamStateText
        {
            get
            {
                if (string.IsNullOrWhiteSpace(_streamState))
                    return "○ 정지됨";

                return _streamState?.ToUpperInvariant() switch
                {
                    "RUNNING" => "● 송출 중",
                    "STARTING" => "◐ 준비 중",
                    "STOPPED" => "○ 정지됨",
                    _ => "○ 정지됨"
                };
            }
        }

        public string StreamStateColor
        {
            get
            {
                if (string.IsNullOrWhiteSpace(_streamState))
                    return "#FF5963"; // Red

                return _streamState?.ToUpperInvariant() switch
                {
                    "RUNNING" => "#3CE48C",  // Green
                    "STARTING" => "#FFA500", // Orange
                    "STOPPED" => "#FF5963",  // Red
                    _ => "#FF5963"           // Red
                };
            }
        }

        public bool IsAgentOnly =>
            string.Equals(Status, "AgentOnly", StringComparison.OrdinalIgnoreCase);

        public bool IsConnected => 
            string.Equals(Status, "Connected", StringComparison.OrdinalIgnoreCase) ||
            (string.Equals(Status, "AgentOnly", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(AgentHost));

        public string BatteryText
        {
            get
            {
                if (BatteryLevel < 0) return "N/A";
                string text = $"{BatteryLevel}%";
                if (IsCharging) text += " ⚡";
                return text;
            }
        }

        public event PropertyChangedEventHandler PropertyChanged;
        protected void OnPropertyChanged([CallerMemberName] string prop = null)
            => PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(prop));

        public override bool Equals(object obj) => obj is Device d && Ip == d.Ip;
        public override int GetHashCode() => Ip != null ? Ip.GetHashCode() : 0;
    }

    internal static class TaskExtensions
    {
        public static async Task<T> WithCancellation<T>(this Task<T> task, CancellationToken token)
        {
            var tcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
            using (token.Register(static s => ((TaskCompletionSource<bool>)s!).TrySetResult(true), tcs))
            {
                if (task == await Task.WhenAny(task, tcs.Task).ConfigureAwait(false))
                    return await task.ConfigureAwait(false);
                throw new OperationCanceledException(token);
            }
        }
    }

