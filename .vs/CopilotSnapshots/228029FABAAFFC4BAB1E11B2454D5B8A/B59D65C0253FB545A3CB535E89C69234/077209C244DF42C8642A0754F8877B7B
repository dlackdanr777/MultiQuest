        private readonly object _mirrorLock = new();

        // ★ 수정: 살아있는 기존 scrcpy는 건드리지 않음 (자동 복구 환경에서 충돌 방지)
        private async void StartMirrorForDevice(Device device)
        {
            if (device == null || !device.IsConnected) return;

            string mirrorKey = device.Ip;

            lock (_mirrorLock)
            {
                // 이미 이 IP에 대해 미러링 시작 중이면 무시
                if (_mirrorStarting.Contains(mirrorKey))
                    return;

                // 기존 scrcpy가 살아있으면 건드리지 않음 (핵심 수정)
                if (_scrcpy.TryGetValue(mirrorKey, out var existing))
                {
                    if (!existing.HasExited)
                        return;

                    _scrcpy.Remove(mirrorKey);
                }

                _mirrorStarting.Add(mirrorKey);
            }

            try
            {
                // host가 null이면 레이아웃이 아직 확정되지 않은 것 → 최대 10회 재시도
                Border host = null;
                for (int i = 0; i < 10; i++)
                {
                    host = FindInItemTemplate<Border>(Tiles, device, "PART_MirrorHost");
                    if (host != null && host.ActualWidth > 1 && host.ActualHeight > 1) break;
                    await Dispatcher.Yield(DispatcherPriority.Loaded);
                    await Task.Delay(150);
                }

                // 여전히 준비 안 됐으면 최대 10회까지 지연 재시도 (간헐적 미표시 방지)
                if (host == null || host.ActualWidth <= 1 || host.ActualHeight <= 1)
                {
                    int retry;
                    lock (_mirrorLock)
                    {
                        _mirrorLayoutRetry.TryGetValue(device.Ip, out retry);
                        _mirrorLayoutRetry[device.Ip] = retry + 1;
                    }
                    if (retry < 10 && device.IsConnected)
                    {
                        await Task.Delay(300);
                        Dispatcher.BeginInvoke(new Action(() => StartMirrorForDevice(device)), DispatcherPriority.ContextIdle);
                    }
                    return;
                }
                lock (_mirrorLock) { _mirrorLayoutRetry.Remove(device.Ip); }

                var proc = await StartMirroringWithSemaphoreAsync(device,
                    (int)Math.Max(1, host.ActualWidth),
                    (int)Math.Max(1, host.ActualHeight),
                    CancellationToken.None);
                if (proc == null || proc.HasExited || proc.MainWindowHandle == IntPtr.Zero)
                    return;

                lock (_mirrorLock)
                {
                    // await 중 다른 프로세스가 이미 정상 등록되었으면 새 프로세스는 종료
                    if (_scrcpy.TryGetValue(mirrorKey, out var existing) && existing != proc && !existing.HasExited)
                    {
                        try { if (!proc.HasExited) proc.Kill(); } catch { }
                        return;
                    }

                    _scrcpy[mirrorKey] = proc;
                    _scrcpyRestartAttempts.Remove(mirrorKey);
                }

                RegisterScrcpyProcess(device, proc, mirrorKey);

                // scrcpy 창 핸들은 생겼지만 renderer/첫 프레임은 늦게 준비될 수 있음
                // 80ms → 1000ms로 증가 (첫 접속 회색 배경 방지)
                await Task.Delay(1000);

                ScrcpyEmbedder.Attach(proc, host, this);
                ScrcpyEmbedder.Adjust(proc, host, this);

                if (_isScanning || PanelMetaDevice.Visibility != Visibility.Visible)
                {
                    ScrcpyEmbedder.HideWindow(proc.MainWindowHandle);

                    // 스캔 중이거나 패널이 숨겨진 경우 나중에 재Attach 대상으로 등록
                    lock (_mirrorLock) { _pendingAttach.Add(mirrorKey); }
                }
                else
                {
                    ScrcpyEmbedder.ShowAll(new[] { proc });

                    // 레이아웃/SetParent 안정화 후 2차/3차 보정 (회색 배경 방지)
                    _ = Dispatcher.BeginInvoke(async () =>
                    {
                        await Task.Delay(500);
                        var h1 = FindInItemTemplate<Border>(Tiles, device, "PART_MirrorHost");
                        if (h1 != null && !proc.HasExited)
                        {
                            ScrcpyEmbedder.Adjust(proc, h1, this);
                            ScrcpyEmbedder.ShowAll(new[] { proc });
                        }

                        await Task.Delay(1000);
                        var h2 = FindInItemTemplate<Border>(Tiles, device, "PART_MirrorHost");
                        if (h2 != null && !proc.HasExited)
                        {
                            ScrcpyEmbedder.Attach(proc, h2, this);
                            ScrcpyEmbedder.Adjust(proc, h2, this);
                            ScrcpyEmbedder.ShowAll(new[] { proc });
                        }
                    }, DispatcherPriority.Loaded);
                }
            }
            finally
            {
                lock (_mirrorLock)
                {
                    _mirrorStarting.Remove(mirrorKey);
                }
            }
        }

        /// <summary>
        /// proc에 Exited 핸들러를 등록한다.
        /// PID 기반으로 이전 프로세스 종료 이벤트가 새 프로세스를 건드리지 못하게 방지한다.
        /// </summary>
        private void RegisterScrcpyProcess(Device device, Process proc, string mirrorKey)
        {
            proc.EnableRaisingEvents = true;

            int exitedPid;
            try { exitedPid = proc.Id; }
            catch { return; }

            proc.Exited += (_, __) =>
            {
                bool shouldRestart = false;

                lock (_mirrorLock)
                {
                    // 현재 등록된 프로세스가 방금 종료된 proc인지 확인
                    if (_scrcpy.TryGetValue(mirrorKey, out var current))
                    {
                        int currentPid = -1;
                        try { currentPid = current.Id; } catch { }

                        if (currentPid == exitedPid)
                        {
                            _scrcpy.Remove(mirrorKey);
                            shouldRestart = true;
                        }
                        else
                        {
                            // 이미 새 scrcpy가 붙어 있으면 이전 프로세스 종료 이벤트는 무시
                            return;
                        }
                    }
                    else
                    {
                        // 이미 Refresh/Stop 쪽에서 제거한 경우도 무시
                        return;
                    }
                }

                if (!shouldRestart || _isShuttingDown || !device.IsConnected)
                    return;

                ScheduleMirrorRestart(device, mirrorKey, $"scrcpy exited pid={exitedPid}");
            };
        }

        /// <summary>
        /// 지수 백오프 방식으로 scrcpy 재시작을 예약한다.
        /// 네트워크가 불안정할 때 루프를 방지하기 위해 1초→3초→7초→15초→30초 간격으로 재시도한다.
        /// </summary>
        private void ScheduleMirrorRestart(Device device, string mirrorKey, string reason)
        {
            CancellationTokenSource cts;
            int attempt;

            lock (_mirrorLock)
            {
                if (_mirrorRestartTokens.ContainsKey(mirrorKey))
                    return;

                _scrcpyRestartAttempts.TryGetValue(mirrorKey, out attempt);
                attempt = Math.Min(attempt + 1, 8);
                _scrcpyRestartAttempts[mirrorKey] = attempt;

                cts = new CancellationTokenSource();
                _mirrorRestartTokens[mirrorKey] = cts;
            }

            int delayMs = attempt switch
            {
                1 => 1000,
                2 => 3000,
                3 => 7000,
                4 => 15000,
                _ => 30000
            };

            Trace.WriteLine($"[MirrorRestart] {device.Name}({mirrorKey}) {reason}, {delayMs}ms 후 재시도 attempt={attempt}");

            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(delayMs, cts.Token);

                    if (cts.Token.IsCancellationRequested || _isShuttingDown)
                        return;

                    // Agent 상태로 확인 (ADB 재연결 제거됨)
                    bool agentReady = !string.IsNullOrWhiteSpace(device.AgentHost);

                    if (!agentReady)
                        return;

                    // 시스템 UI 활성 중이면 재시작하지 않음 (Boundary/설정 화면 보호)
                    if (device.SystemUIActive)
                    {
                        Trace.WriteLine($"[MirrorRestart] {device.Name}: 시스템 UI 활성 중이므로 재시작 건너뜀");
                        return;
                    }

                    await Dispatcher.InvokeAsync(() =>
                    {
                        if (_isShuttingDown || !device.IsConnected)
                            return;

                        bool hasProc;
                        lock (_mirrorLock)
                        {
                            hasProc = _scrcpy.TryGetValue(device.Ip, out var p) && !p.HasExited;
                        }

                        if (!hasProc)
                            StartMirrorForDevice(device);
                    });
                }
                catch (TaskCanceledException)
                {
                }
                catch (Exception ex)
                {
                    Trace.WriteLine($"[MirrorRestart] 예외: {ex.Message}");
                }
                finally
                {
                    lock (_mirrorLock)
                    {
                        if (_mirrorRestartTokens.TryGetValue(mirrorKey, out var old) && ReferenceEquals(old, cts))
                            _mirrorRestartTokens.Remove(mirrorKey);

                        cts.Dispose();
                    }
                }
            });
        }

        /// <summary>
        /// 진행 중인 미러링 재시작 작업을 취소한다.
        /// Refresh/Stop 버튼 클릭 시 호출하여 예약된 재시작이 새 프로세스를 방해하지 않도록 한다.
        /// </summary>
        private void CancelPendingMirrorRestart(string mirrorKey)
        {
            lock (_mirrorLock)
            {
                if (_mirrorRestartTokens.TryGetValue(mirrorKey, out var cts))
                {
                    try { cts.Cancel(); } catch { }
                    _mirrorRestartTokens.Remove(mirrorKey);
                    try { cts.Dispose(); } catch { }
                }

                _scrcpyRestartAttempts.Remove(mirrorKey);
            }
        }

        /// <summary>
        /// scrcpy 출력에서 중요한 오류 메시지를 추출한다.
        /// ERROR, WARN, failed 등이 포함된 줄을 우선적으로 표시한다.
        /// </summary>
        private static string PickImportantScrcpyError(string stdout, string stderr, int exitCode)
        {
            string combined = ((stderr ?? "") + "\n" + (stdout ?? "")).Trim();

            if (string.IsNullOrWhiteSpace(combined))
                return $"scrcpy 종료됨 (exitCode={exitCode})";

            var lines = combined
                .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToList();

            string important = lines.FirstOrDefault(x =>
                x.Contains("ERROR", StringComparison.OrdinalIgnoreCase) ||
                x.Contains("WARN", StringComparison.OrdinalIgnoreCase) ||
                x.Contains("failed", StringComparison.OrdinalIgnoreCase) ||
                x.Contains("closed", StringComparison.OrdinalIgnoreCase) ||
                x.Contains("disconnect", StringComparison.OrdinalIgnoreCase) ||
                x.Contains("device offline", StringComparison.OrdinalIgnoreCase) ||
                x.Contains("device not found", StringComparison.OrdinalIgnoreCase));

            return important ?? lines.LastOrDefault() ?? $"scrcpy 종료됨 (exitCode={exitCode})";
        }

