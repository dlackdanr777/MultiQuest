        /// <summary>
        /// KeepAwake 재확인 타이머 - Agent KeepAwake Lock이 살아있는지 주기적으로 검증
        /// </summary>
        private async void KeyEventTimer_Tick(object? sender, EventArgs e)
        {
            if (_isKeepAwakeTickRunning)
                return;

            _isKeepAwakeTickRunning = true;

            try
            {
                var agentDevices = Devices
                    .Where(d => !string.IsNullOrWhiteSpace(d.AgentHost))
                    .ToList();

                if (agentDevices.Count == 0)
                    return;

                await Task.WhenAll(agentDevices.Select(async device =>
                {
                    try
                    {
                        await AgentApi.KeepAwakeAsync(
                            device.AgentHost,
                            device.AgentStatusPort,
                            enabled: true);
                    }
                    catch (Exception ex)
                    {
                        Debug.WriteLine($"[KeepAwake] failed: {device.Name} {ex.Message}");
                    }
                }));
            }
            finally
            {
                _isKeepAwakeTickRunning = false;
            }
        }

        /// <summary>
        /// Display 0 블록만 조회해 OFF/DOZE 여부를 판단한다.
        /// 전체 문자열 Contains로 다른 display의 상태를 오판정하는 것을 방지한다.
        /// </summary>
        private static bool IsDisplay0OffOrDoze(string displayList)
        {
            if (string.IsNullOrWhiteSpace(displayList)) return false;
            var blocks = Regex.Split(displayList, @"(?=Display\s+\d+)")
                              .Where(b => !string.IsNullOrWhiteSpace(b));
            var display0 = blocks.FirstOrDefault(b =>
                Regex.IsMatch(b, @"Display\s+0\b", RegexOptions.IgnoreCase));
            if (string.IsNullOrWhiteSpace(display0)) return false;
            return display0.Contains("state=OFF",  StringComparison.OrdinalIgnoreCase) ||
                   display0.Contains("state=DOZE", StringComparison.OrdinalIgnoreCase);
        }

        /// <summary>
        /// Agent 디바이스 재연결 시도 예약
        /// Failed 상태의 Agent 디바이스를 주기적으로 재탐지하여 자동 재연결
        /// </summary>
        private void ScheduleAgentReconnect(Device device)
        {
            if (device == null || string.IsNullOrWhiteSpace(device.AgentHost)) return;

            lock (_agentReconnectAttempts)
            {
                var now = DateTime.UtcNow;

                // 이미 재연결 시도 중이면 스킵
                if (_agentReconnectAttempts.TryGetValue(device.Ip, out var lastAttempt))
                {
                    // 최소 10초 간격으로 재시도
                    if ((now - lastAttempt).TotalSeconds < 10)
                        return;
                }

                // 재연결 시도 시간 기록
                _agentReconnectAttempts[device.Ip] = now;
            }

            // 백그라운드에서 재연결 시도
            Task.Run(async () =>
            {
                try
                {
                    // ConnectionCheckTimer가 다시 체크하므로 여기서는 단순히 다음 체크 주기를 기다림
                    // 실제 상태는 ConnectionCheckTimer_Tick에서 업데이트됨
                    Debug.WriteLine($"[Agent Reconnect] Scheduled reconnection attempt for {device.Name} ({device.AgentHost}:{device.AgentStatusPort})");
                }
                catch (Exception ex)
                {
                    Debug.WriteLine($"[Agent Reconnect] Error scheduling reconnection for {device.Name}: {ex.Message}");
                }
            });
        }

