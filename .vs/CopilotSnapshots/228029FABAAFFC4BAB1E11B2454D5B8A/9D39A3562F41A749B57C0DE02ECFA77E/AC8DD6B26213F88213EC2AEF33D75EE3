<Window x:Class="MultiQuest_Management.RtspMirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="MultiQuest RTSP Mirror"
        WindowState="Maximized"
        Background="#111111">

    <Grid>
        <ItemsControl ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Columns}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="6"
                            Background="#222222"
                            BorderBrush="#444444"
                            BorderThickness="1"
                            CornerRadius="4">

                        <Grid>
                            <vlc:VideoView MediaPlayer="{Binding MediaPlayer}">
                                <Grid IsHitTestVisible="False">

                                    <Border VerticalAlignment="Top"
                                            Background="#AA000000"
                                            Padding="8"
                                            Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="White"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />

                                            <TextBlock Text="{Binding Subtitle}"
                                                       Foreground="#CCCCCC"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </Border>

                                    <Border VerticalAlignment="Bottom"
                                            Background="#AA000000"
                                            Padding="8"
                                            Margin="0">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                </Grid>
                            </vlc:VideoView>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
