using LibVLCSharp.Shared;
using System.ComponentModel;
using System.Runtime.CompilerServices;
using System.Windows.Media;

namespace MultiQuest_Management
{
    public sealed class RtspTileViewModel : INotifyPropertyChanged, IDisposable
    {
        private readonly LibVLC _libVlc;
        private Media? _media;
        private string _status = "대기 중";
        private Brush _statusBrush = Brushes.LightGray;
        private bool _disposed;

        public QuestAgentInfo Agent { get; }

        public MediaPlayer MediaPlayer { get; }

        public string Title =>
            string.IsNullOrWhiteSpace(Agent.Model)
                ? Agent.Host
                : $"{Agent.Model}";

        public string Subtitle =>
            $"{Agent.Host}:{Agent.StatusPort} / Battery {Agent.Battery}%";

        public string Status
        {
            get => _status;
            private set
            {
                if (_status == value) return;
                _status = value;
                OnPropertyChanged();
            }
        }

        public Brush StatusBrush
        {
            get => _statusBrush;
            private set
            {
                if (_statusBrush == value) return;
                _statusBrush = value;
                OnPropertyChanged();
            }
        }

        public RtspTileViewModel(LibVLC libVlc, QuestAgentInfo agent)
        {
            _libVlc = libVlc;
            Agent = agent;

            MediaPlayer = new MediaPlayer(_libVlc)
            {
                EnableHardwareDecoding = true,
                Mute = true
            };

            MediaPlayer.Playing += (_, __) =>
                SetStatus("재생 중", Brushes.LightGreen);

            MediaPlayer.Buffering += (_, e) =>
                SetStatus($"버퍼링 {e.Cache:0}%", Brushes.Khaki);

            MediaPlayer.EncounteredError += (_, __) =>
                SetStatus("재생 오류", Brushes.OrangeRed);

            MediaPlayer.Stopped += (_, __) =>
                SetStatus("중지됨", Brushes.LightGray);

            MediaPlayer.EndReached += (_, __) =>
                SetStatus("스트림 종료됨", Brushes.Orange);
        }

        public void Start()
        {
            if (_disposed) return;

            if (string.IsNullOrWhiteSpace(Agent.RtspUrl))
            {
                SetStatus("RTSP URL 없음", Brushes.OrangeRed);
                return;
            }

            try
            {
                SetStatus($"연결 중: {Agent.RtspUrl}", Brushes.Khaki);

                _media?.Dispose();
                _media = new Media(_libVlc, Agent.RtspUrl, FromType.FromLocation);

                // 로컬 RTSP 안정화 옵션
                _media.AddOption(":rtsp-tcp");
                _media.AddOption(":network-caching=250");
                _media.AddOption(":live-caching=250");
                _media.AddOption(":clock-jitter=0");
                _media.AddOption(":drop-late-frames");
                _media.AddOption(":skip-frames");

                MediaPlayer.Play(_media);
            }
            catch (Exception ex)
            {
                SetStatus($"재생 시작 실패: {ex.Message}", Brushes.OrangeRed);
            }
        }

        public void Stop()
        {
            try
            {
                MediaPlayer.Stop();
            }
            catch
            {
                // ignored
            }
        }

        private void SetStatus(string status, Brush brush)
        {
            System.Windows.Application.Current.Dispatcher.InvokeAsync(() =>
            {
                Status = status;
                StatusBrush = brush;
            });
        }

        public void Dispose()
        {
            if (_disposed) return;
            _disposed = true;

            try { MediaPlayer.Stop(); } catch { }
            try { _media?.Dispose(); } catch { }
            try { MediaPlayer.Dispose(); } catch { }
        }

        public event PropertyChangedEventHandler? PropertyChanged;

        private void OnPropertyChanged([CallerMemberName] string? prop = null)
            => PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(prop));
    }
}
