        /// <summary>
        /// Agent 디바이스 재연결 시도 예약
        /// Failed 상태의 Agent 디바이스를 주기적으로 재탐지하여 자동 재연결
        /// </summary>
        private void ScheduleAgentReconnect(Device device)
        {
            if (device == null || string.IsNullOrWhiteSpace(device.AgentHost)) return;

            lock (_agentReconnectAttempts)
            {
                var now = DateTime.UtcNow;

                // 이미 재연결 시도 중이면 스킵
                if (_agentReconnectAttempts.TryGetValue(device.Ip, out var lastAttempt))
                {
                    // 최소 10초 간격으로 재시도
                    if ((now - lastAttempt).TotalSeconds < 10)
                        return;
                }

                // 재연결 시도 시간 기록
                _agentReconnectAttempts[device.Ip] = now;
            }

            // 백그라운드에서 재연결 시도
            Task.Run(async () =>
            {
                try
                {
                    // ConnectionCheckTimer가 다시 체크하므로 여기서는 단순히 다음 체크 주기를 기다림
                    // 실제 상태는 ConnectionCheckTimer_Tick에서 업데이트됨
                    Debug.WriteLine($"[Agent Reconnect] Scheduled reconnection attempt for {device.Name} ({device.AgentHost}:{device.AgentStatusPort})");
                }
                catch (Exception ex)
                {
                    Debug.WriteLine($"[Agent Reconnect] Error scheduling reconnection for {device.Name}: {ex.Message}");
                }
            });
        }


        /// <summary>
        /// 통합 상태 체크: 배터리, RTSP, 오프라인 감지를 짧은 주기로 처리
        /// </summary>
        private async void UpdateStatus(object? sender, EventArgs e)
        {
            if (_isStatusCheckRunning) return;
            _isStatusCheckRunning = true;
            try
            {
                var targets = Devices
                    .Where(d => d != null && !string.IsNullOrWhiteSpace(d.AgentHost))
                    .ToList();

                if (targets.Count == 0) return;

                // 1초 타임아웃으로 병렬 조회
                var tasks = targets.Select(device => Task.Run(async () =>
                {
                    var status = await AgentApi.GetStatusFastAsync(
                        device.AgentHost, device.AgentStatusPort);
                    return (Ip: device.Ip, Status: status);
                }));

                var results = await Task.WhenAll(tasks);

                await Dispatcher.InvokeAsync(() =>
                {
                    foreach (var item in results)
                    {
                        string ip = item.Ip;
                        QuestAgentInfo status = item.Status;

                        // DeviceId 우선, 없으면 IP 폴백
                        Device d;
                        if (status != null && !string.IsNullOrWhiteSpace(status.DeviceId))
                            d = Devices.FirstOrDefault(x =>
                                string.Equals(x.AgentDeviceId, status.DeviceId, StringComparison.OrdinalIgnoreCase))
                              ?? Devices.FirstOrDefault(x => x.Ip == ip);
                        else
                            d = Devices.FirstOrDefault(x => x.Ip == ip);

                        if (d == null) continue;

                        // DeviceId 갱신
                        if (status != null && !string.IsNullOrWhiteSpace(status.DeviceId))
                            d.AgentDeviceId = status.DeviceId;

                        if (status == null)
                        {
                            // 응답 없음 → 즉시 Failed
                            int miss;
                            lock (_missLock)
                            {
                                _missCounts.TryGetValue(d.Ip, out miss);
                                _missCounts[d.Ip] = ++miss;
                            }

                            if (miss >= 2 && d.Status != "Failed")
                            {
                                d.Status = "Failed";
                                d.StreamState = null;
                                // RTSP 타일 정지
                                try { d.Rtsp?.Stop(); } catch { }
                                Debug.WriteLine($"[Offline] {d.Name} ({d.AgentHost}) 오프라인 감지 (miss={miss})");
                            }
                        }
                        else
                        {
                            // 응답 성공
                            lock (_missLock) { _missCounts[d.Ip] = 0; }

                            if (d.Status == "Failed" || d.Status == "AgentOnly")
                            {
                                d.Status = "Connected";
                                Debug.WriteLine($"[Online] {d.Name} ({d.AgentHost}) 재연결");
                                // RTSP URL이 있으면 타일 재시작
                                if (!string.IsNullOrWhiteSpace(d.RtspUrl))
                                    HardRestartRtspTile(d, "reconnected");
                            }

                            if (status.Battery >= 0)  d.BatteryLevel  = status.Battery;
                            d.IsCharging   = status.IsCharging;
                            if (!string.IsNullOrEmpty(status.ChargingStatus))
                                d.ChargingStatus = status.ChargingStatus;
                            if (!string.IsNullOrEmpty(status.Serial) && string.IsNullOrEmpty(d.Serial))
                                d.Serial = status.Serial;

                            if (!string.IsNullOrWhiteSpace(status.StreamState))
                            {
                                bool httpStopped =
                                    string.Equals(status.StreamState, "STOPPED", StringComparison.OrdinalIgnoreCase) ||
                                    string.Equals(status.StreamState, "IDLE", StringComparison.OrdinalIgnoreCase);
                                bool rtspFrozen = d.Rtsp?.IsFrozen == true;
                                bool httpSaysActive =
                                    string.Equals(status.StreamState, "RUNNING", StringComparison.OrdinalIgnoreCase) ||
                                    string.Equals(status.StreamState, "STARTING", StringComparison.OrdinalIgnoreCase);

                                if (httpStopped)
                                {
                                    // Agent가 STOPPED/IDLE을 보낸 경우 → RTSP 타일 즉시 정지
                                    d.StreamState = status.StreamState;
                                    if (d.Rtsp != null && d.Rtsp.IsPlaying)
                                    {
                                        Debug.WriteLine($"[StreamStop] {d.Name} Agent {status.StreamState} → RTSP 타일 정지");
                                        try { d.Rtsp.Stop(); } catch { }
                                    }
                                }
                                else if (rtspFrozen && httpSaysActive)
                                {
                                    // RTSP 타일이 이미 프리즈 감지 → HTTP의 RUNNING 무시
                                    d.StreamState = "FROZEN";
                                }
                                else
                                {
                                    d.StreamState = status.StreamState;
                                }
                            }

                            // 이름 우선순위
                            if (!string.IsNullOrWhiteSpace(status.DeviceName))
                                d.Name = status.DeviceName.Trim();
                            else if (!string.IsNullOrEmpty(d.Serial)
                                && _serialNameDic.TryGetValue(d.Serial, out var mapped)
                                && !string.IsNullOrWhiteSpace(mapped))
                                d.Name = mapped.Trim();

                            // RTSP URL 변경 체크
                            if (!string.IsNullOrEmpty(status.RtspUrl) && d.RtspUrl != status.RtspUrl)
                            {
                                d.RtspUrl = status.RtspUrl;
                                if (d.Rtsp != null)
                                    HardRestartRtspTile(d, "RTSP URL changed");
                            }
                            else if (!string.IsNullOrEmpty(status.RtspUrl))
                            {
                                d.RtspUrl = status.RtspUrl;
                            }

                            _ = CheckRtspRecoveryAsync(d.Ip, d.RtspUrl, d.StreamState);
                            _ = CheckRtspClientStallAsync(d);

                            // ── 인코더 stall 감지 ──────────────────────────────────────
                            // Agent가 RUNNING인데 encodedFrameCount / lastFrameAtMs가 멈춰 있으면
                            // 인코더 문제로 판단 → restartCapture + HardRestart
                            bool agentRunning = string.Equals(d.StreamState, "RUNNING",
                                StringComparison.OrdinalIgnoreCase);

                            if (agentRunning && d.Rtsp != null)
                            {
                                bool hasFrameCount = status.EncodedFrameCount > 0;
                                bool hasFrameTime  = status.LastFrameAtMs > 0;

                                if (hasFrameCount || hasFrameTime)
                                {
                                    // lastFrameAtMs 기반: Agent 기준으로 마지막 프레임이 얼마나 됐는지
                                    if (hasFrameTime)
                                    {
                                        long nowMs  = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                                        long ageSec = (nowMs - status.LastFrameAtMs) / 1000;

                                        if (ageSec >= 8)
                                        {
                                            string key = $"encstall:{d.AgentHost}";
                                            if (CanHardRestartRtsp(key, cooldownMs: 20_000))
                                            {
                                                Debug.WriteLine(
                                                    $"[EncStall] {d.Name} lastFrameAtMs={status.LastFrameAtMs} " +
                                                    $"→ {ageSec}초 경과. 인코더 stall. restartCapture + HardRestart");
                                                d.LastKnownEncodedFrameCount = -1;
                                                d.EncodedFrameCountSameAtUtc = DateTime.MinValue;
                                                _ = AgentApi.RestartCaptureAsync(d.AgentHost, d.AgentStatusPort);
                                                HardRestartRtspTile(d, "encoder stall: lastFrameAtMs frozen");
                                            }
                                        }
                                    }
                                    // encodedFrameCount 기반: 폴링 사이에 카운트가 늘지 않으면 stall
                                    else if (hasFrameCount)
                                    {
                                        if (d.LastKnownEncodedFrameCount != status.EncodedFrameCount)
                                        {
                                            d.LastKnownEncodedFrameCount = status.EncodedFrameCount;
                                            d.EncodedFrameCountSameAtUtc = DateTime.UtcNow;
                                            Debug.WriteLine(
                                                $"[EncFrame] {d.Name} encodedFrameCount={status.EncodedFrameCount} (증가 중)");
                                        }
                                        else if (d.EncodedFrameCountSameAtUtc != DateTime.MinValue)
                                        {
                                            var stuckSec = (DateTime.UtcNow - d.EncodedFrameCountSameAtUtc).TotalSeconds;
                                            if (stuckSec >= 10)
                                            {
                                                string key = $"encstall:{d.AgentHost}";
                                                if (CanHardRestartRtsp(key, cooldownMs: 20_000))
                                                {
                                                    Debug.WriteLine(
                                                        $"[EncStall] {d.Name} encodedFrameCount={status.EncodedFrameCount} " +
                                                        $"정체 {stuckSec:F0}초. 인코더 stall. restartCapture + HardRestart");
                                                    d.EncodedFrameCountSameAtUtc = DateTime.MinValue;
                                                    _ = AgentApi.RestartCaptureAsync(d.AgentHost, d.AgentStatusPort);
                                                    HardRestartRtspTile(d, "encoder stall: frameCount frozen");
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            else
                            {
                                // RUNNING 아닐 때는 트래킹 리셋
                                d.LastKnownEncodedFrameCount = -1;
                                d.EncodedFrameCountSameAtUtc = DateTime.MinValue;
                            }
                        }
                    }
                });
            }
            finally
            {
                _isStatusCheckRunning = false;
            }
        }

        private void OnChangeSerialName(IReadOnlyDictionary<string, string> serialNameDic)
        {
            // 최신 스냅샷으로 갱신 (저장 직후 반영 누락 방지)
            _serialNameDic = serialNameDic ?? new Dictionary<string, string>();

            foreach (var device in Devices)
            {
                if (_serialNameDic.TryGetValue(device.Serial, out var name))
                {
                    if (device.Name?.Equals(name, StringComparison.Ordinal) == true) continue;
                    device.Name = name;
                }
                else
                {
                    device.Name = device.Serial; // 시리얼을 이름으로 사용
                }
            }
            // 이름 변경 즉시 UI 반영
            UpdateDeviceLabels();
        }

        // 디바이스 이름(Label) 즉시 반영
        private void UpdateDeviceLabels()
        {
            if (Tiles == null || Devices == null) return;
            foreach (var device in Devices)
            {
                var host = FindInItemTemplate<Border>(Tiles, device, "PART_MirrorHost");
                if (host == null) continue;
                var label = FindVisualChildByName<System.Windows.Controls.Label>(host, "DeviceNameLabel");
                if (label != null) label.Content = device.Name;
            }
        }

