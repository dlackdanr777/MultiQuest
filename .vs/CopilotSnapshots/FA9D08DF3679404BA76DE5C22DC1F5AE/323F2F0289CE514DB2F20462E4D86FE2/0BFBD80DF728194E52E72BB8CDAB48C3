        private async void RefreshTile_Click(object sender, RoutedEventArgs e)
        {
            if (_isRefreshing)
            {
                MessageBox.Show("이미 새로고침 중입니다.");
                return;
            }
            _isRefreshing = true;
            if ((sender as Button)?.CommandParameter is not Device device) { _isRefreshing = false; return; }

            // 이미 HardRestart 진행 중이면 무시
            string host = !string.IsNullOrWhiteSpace(device.AgentHost)
                ? device.AgentHost : GetHostOnly(device.Ip);
            lock (_rtspHealthLock)
            {
                if (_rtspRestartInProgress.Contains(host))
                {
                    _isRefreshing = false;
                    return;
                }
            }

            // RTSP 타일 하드 재시작
            if (device.Rtsp != null)
            {
                try
                {
                    // Wake 명령 전송
                    if (!string.IsNullOrWhiteSpace(device.AgentHost))
                    {
                        await AgentApi.WakeScreenAsync(
                            device.AgentHost,
                            device.AgentStatusPort,
                            keepAwake: true);
                    }

                    await Task.Delay(500);

                    // RTSP 타일 완전히 재생성 - 백그라운드에서 실행
                    await HardRestartRtspTileAsync(device, "manual refresh button");
                }
                finally
                {
                    _isRefreshing = false;
                }
            }
            else
            {
                _isRefreshing = false;
            }
        }

