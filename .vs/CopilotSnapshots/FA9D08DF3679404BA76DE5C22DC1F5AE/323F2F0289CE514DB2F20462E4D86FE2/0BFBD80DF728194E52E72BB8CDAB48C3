            void ShowInternal()
            {
                try
                {
                    if (this.IsLoaded && this.IsVisible)
                        MessageBox.Show(this, msg, "알림", MessageBoxButton.OK, MessageBoxImage.Information);
                    else
                        MessageBox.Show(msg, "알림", MessageBoxButton.OK, MessageBoxImage.Information);
